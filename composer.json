{
    "name": "auxioma/le-commerce",
    "description": "Le Commerce - Bar/Tabac/PMU/FDJ/Presse - Site + back-office (PHP MVC natif)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "endroid/qr-code": "^6.1",
        "robmorgan/phinx": "^0.16",
        "twig/twig": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/helpers.php"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
