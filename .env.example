# Application
APP_ENV=development
APP_DEBUG=true
APP_URL=http://lecommercetabac.test
APP_KEY=change-me-32-chars-random-string

# Base de données (accès Laragon par défaut)
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=le_commerce
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Base de données dédiée aux tests Phinx (migrate/seed/rollback), jamais
# la base de dev réelle ci-dessus (voir phinx.php, environnement "test").
DB_NAME_TEST=le_commerce_phinx_test

# Mail (formulaire de contact)
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=noreply@lecommercetabac.fr
MAIL_FROM_NAME=Le Commerce

# Google
# Identifiant du lieu (fiche établissement) sur Google Maps, ex. "ChIJ..."
# Trouvable via https://developers.google.com/maps/documentation/places/web-service/place-id
GOOGLE_PLACE_ID=
# Clé API "Places API" (Google Cloud Console > API et services > Identifiants),
# utilisée pour récupérer la note globale et le nombre d'avis sur la page d'accueil
GOOGLE_PLACES_API_KEY=
GOOGLE_ANALYTICS_ID=
# ID de propriété GA4 (numérique) pour l'API GA4 Data (/admin/google-analytics)
GA4_PROPERTY_ID=
# Connexion OAuth à l'API GA4 Data (Google Cloud Console > Identifiants > Client OAuth 2.0)
GA4_OAUTH_CLIENT_ID=
GA4_OAUTH_CLIENT_SECRET=
# Obtenu automatiquement (et réécrit dans .env) lors de la connexion depuis /admin/parametres
GA4_OAUTH_REFRESH_TOKEN=

# WhatsApp Business API (lot back-office)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# AllMySms — https://manager.allmysms.com (rubrique API / Clé d'API & Paramètres)
# Utilisé pour l'envoi automatique du SMS d'annonce à la création d'une
# loterie, et pour les statistiques de campagne affichées sur /admin/loterie.
ALLMYSMS_LOGIN=
ALLMYSMS_API_KEY=
# Nom d'expéditeur affiché (3 à 11 caractères alphanumériques, sans accents)
ALLMYSMS_SENDER=LeCommerce
