{% set itemBase = 'flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-colors' %}
{% set itemDefault = itemBase ~ ' text-gray-300 hover:bg-white/5 hover:text-white' %}
{% set itemActive = itemBase ~ ' bg-[#2563eb] text-white' %}
{% set itemHome = itemBase ~ ' bg-brand-500 text-white hover:bg-brand-600' %}

{% set clientsOpen = currentUri starts with '/admin/clients' or currentUri starts with '/admin/portefeuilles' %}
{% set fidelOpen = currentUri starts with '/admin/offres' or currentUri starts with '/admin/zonage' or currentUri starts with '/admin/loterie' %}

<div id="admin-sidebar-backdrop" class="hidden fixed inset-0 bg-black/40 z-40 lg:hidden"></div>
<aside id="admin-sidebar" class="fixed lg:sticky top-0 left-0 z-50 flex flex-col w-80 shrink-0 bg-slate-950 text-white/90 h-screen overflow-y-auto -translate-x-full lg:translate-x-0 transition-transform duration-200 shadow-2xl">
  <style>
    .sidebar-group > summary::-webkit-details-marker { display: none; }
    .sidebar-group > summary { list-style: none; }
    .sidebar-group[open] .chevron { transform: rotate(180deg); }
  </style>

  <div class="px-6 py-5 border-b border-white/10">
    {% set sidebarLogoUrl = site_image(settings, 'logo_site', '') %}
    <a href="{{ base_path }}/admin" class="block sidebar-logo">
      {% if sidebarLogoUrl %}
        <img src="{{ sidebarLogoUrl }}" alt="{{ shop.name }}" class="h-9 w-auto sidebar-logo-text">
      {% else %}
        <span class="font-logo text-[28px] text-brand-500 -mb-1 sidebar-logo-text block">{{ shop.name }}</span>
        <span class="text-[10px] tracking-[0.18em] text-gray-500 font-medium sidebar-logo-tagline block">BAR · TABAC · PMU · FDJ · PRESSE</span>
      {% endif %}
    </a>
  </div>

  <nav class="flex-1 px-4 py-5 space-y-1">
    <a href="{{ base_path }}/admin" class="{{ itemHome }}">
      {{ icons.home|raw }}
      <span class="flex-1">Accueil</span>
    </a>

    <p class="px-3 mt-6 mb-2 text-[10px] font-bold uppercase tracking-widest text-gray-500">Gestion</p>
    <a href="{{ base_path }}/admin/bar" class="{{ currentUri starts with '/admin/bar' ? itemActive : itemDefault }}">
      {{ icons.bar|raw }}
      <span class="flex-1">Bar</span>
    </a>
    <a href="{{ base_path }}/admin/tabac" class="{{ currentUri starts with '/admin/tabac' ? itemActive : itemDefault }}">
      {{ icons.tabac|raw }}
      <span class="flex-1">Tabac</span>
    </a>
    <a href="{{ base_path }}/admin/fdj" class="{{ currentUri starts with '/admin/fdj' ? itemActive : itemDefault }}">
      {{ icons.jeux|raw }}
      <span class="flex-1">Jeux &amp; Services</span>
    </a>
    <a href="{{ base_path }}/admin/pmu" class="{{ currentUri starts with '/admin/pmu' ? itemActive : itemDefault }}">
      {{ icons.pmu|raw }}
      <span class="flex-1">PMU</span>
    </a>
    <a href="{{ base_path }}/admin/services" class="{{ itemDefault }}">
      {{ icons.nirio|raw }}
      <span class="flex-1">NIRIO</span>
    </a>

    <a href="{{ base_path }}/admin/employes" class="{{ currentUri == '/admin/employes' ? itemActive : itemDefault }}">
      {{ icons.employes|raw }}
      <span class="flex-1">Employés</span>
    </a>

    <details class="sidebar-group mt-1" {{ clientsOpen ? 'open' : '' }}>
      <summary class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-colors cursor-pointer select-none {{ clientsOpen ? itemActive : itemDefault }}">
        {{ icons.users|raw }}
        <span class="flex-1">Clients &amp; Prestataires</span>
        {{ icons.chevron|raw }}
      </summary>
      <div class="pl-4 pr-1 mt-1 space-y-1 border-l border-white/10 ml-5">
        <a href="{{ base_path }}/admin/clients" class="{{ currentUri starts with '/admin/clients' ? itemActive : itemDefault }}">
          {{ icons['client-list']|raw }}
          <span class="flex-1">Clients Inscrits</span>
        </a>
        <a href="{{ base_path }}/admin/portefeuilles" class="{{ currentUri starts with '/admin/portefeuilles' ? itemActive : itemDefault }}">
          {{ icons.wallet|raw }}
          <span class="flex-1">Portefeuille Client</span>
        </a>
      </div>
    </details>

    <a href="{{ base_path }}/admin/reservations" class="{{ currentUri == '/admin/reservations' ? itemActive : itemDefault }}">
      {{ icons.resa|raw }}
      <span class="flex-1">Réservations</span>
    </a>

    <a href="{{ base_path }}/admin/offres" class="{{ currentUri == '/admin/offres' ? itemActive : itemDefault }}">
      {{ icons.marketing|raw }}
      <span class="flex-1">Marketing</span>
    </a>

    <a href="{{ base_path }}/admin/images" class="{{ currentUri == '/admin/images' ? itemActive : itemDefault }}">
      {{ icons.content|raw }}
      <span class="flex-1">Contenu du site</span>
    </a>

    <a href="{{ base_path }}/admin/messages" class="{{ currentUri == '/admin/messages' ? itemActive : itemDefault }}">
      {{ icons.messages|raw }}
      <span class="flex-1">Messages</span>
      {% if unreadMessagesCount > 0 %}
        <span class="inline-flex items-center justify-center min-w-[20px] h-5 px-1.5 rounded-full bg-red-500 text-white text-[10px] font-bold">{{ unreadMessagesCount }}</span>
      {% endif %}
    </a>

    <a href="{{ base_path }}/admin/avis-google" class="{{ currentUri == '/admin/avis-google' ? itemActive : itemDefault }}">
      {{ icons.avis|raw }}
      <span class="flex-1">Avis</span>
    </a>

    <details class="sidebar-group mt-1" {{ fidelOpen ? 'open' : '' }}>
      <summary class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-colors cursor-pointer select-none {{ fidelOpen ? itemActive : itemDefault }}">
        {{ icons.fidel|raw }}
        <span class="flex-1">Fidélisations</span>
        {{ icons.chevron|raw }}
      </summary>
      <div class="pl-4 pr-1 mt-1 space-y-1 border-l border-white/10 ml-5">
        <a href="{{ base_path }}/admin/offres" class="{{ currentUri == '/admin/offres' ? itemActive : itemDefault }}">
          {{ icons.fidel|raw }}
          <span class="flex-1">Offres &amp; Avantages</span>
        </a>
        <a href="{{ base_path }}/admin/offres/scanner" class="{{ currentUri == '/admin/offres/scanner' ? itemActive : itemDefault }}">
          {{ icons.scanner|raw }}
          <span class="flex-1">Scanner une offre</span>
        </a>
        <a href="{{ base_path }}/admin/zonage" class="{{ currentUri == '/admin/zonage' ? itemActive : itemDefault }}">
          {{ icons.zonage|raw }}
          <span class="flex-1">Zonage &amp; Proximité</span>
        </a>
        <a href="{{ base_path }}/admin/loterie" class="{{ currentUri == '/admin/loterie' ? itemActive : itemDefault }}">
          {{ icons.loterie|raw }}
          <span class="flex-1">Loterie</span>
        </a>
      </div>
    </details>

    <a href="{{ base_path }}/admin/sondages" class="{{ currentUri == '/admin/sondages' ? itemActive : itemDefault }}">
      {{ icons.poll|raw }}
      <span class="flex-1">Sondages &amp; Votes</span>
    </a>

    <a href="{{ base_path }}/admin/statistiques" class="{{ currentUri == '/admin/statistiques' ? itemActive : itemDefault }}">
      {{ icons.stats|raw }}
      <span class="flex-1">Statistiques</span>
    </a>

    <a href="{{ base_path }}/admin/google-analytics" class="{{ currentUri == '/admin/google-analytics' ? itemActive : itemDefault }}">
      {{ icons.ga|raw }}
      <span class="flex-1">Google Analytics</span>
    </a>

    <a href="{{ base_path }}/admin/parametres" class="{{ currentUri == '/admin/parametres' ? itemActive : itemDefault }}">
      {{ icons.settings|raw }}
      <span class="flex-1">Paramètres</span>
    </a>

    <a href="{{ base_path }}/admin/maintenance" class="{{ currentUri == '/admin/maintenance' ? itemActive : itemDefault }}">
      {{ icons.maintenance|raw }}
      <span class="flex-1">Maintenance</span>
      {% if settings.maintenance_enabled == '1' %}
        <span class="inline-flex items-center justify-center min-w-[8px] h-2 w-2 rounded-full bg-red-500"></span>
      {% endif %}
    </a>

    <span class="{{ itemDefault }} opacity-60 cursor-not-allowed mt-1">
      {{ icons.support|raw }}
      <span class="flex-1">Support</span>
    </span>
  </nav>

  <div class="px-4 py-5 border-t border-white/10 mt-auto">
    <div class="rounded-2xl bg-slate-900/70 overflow-hidden">
      {% set shopPhotoUrl = site_image(settings, 'hero_accueil', base_path ~ '/assets/images/hero-facade.jpg') %}
      <img src="{{ shopPhotoUrl }}" alt="{{ shop.name }}" class="w-full h-28 object-cover">
      <div class="p-4 text-sm">
        <p class="font-bold text-white">{{ shop.name }}</p>
        <p class="text-[10px] tracking-wide text-gray-400 mt-0.5">BAR · TABAC · PMU · FDJ · PRESSE</p>
        <p class="text-xs text-gray-500 mt-2 leading-snug">
          {{ shop.address }}<br>
          {{ shop.zipcode }} {{ shop.city }}
        </p>
        <a href="{{ base_path }}/" target="_blank" class="mt-3 w-full inline-flex items-center justify-center gap-2 rounded-xl bg-white/10 hover:bg-white/20 text-white text-xs font-semibold py-2.5 transition-colors">
          Voir le site
        </a>
      </div>
    </div>

    <form method="POST" action="{{ base_path }}/deconnexion" class="mt-3">
      {{ csrf_field() }}
      <button type="submit" class="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium text-gray-400 hover:text-white hover:bg-white/5 transition-colors">
        {{ icons.logout|raw }}
        <span>Déconnexion</span>
      </button>
    </form>
  </div>
</aside>
