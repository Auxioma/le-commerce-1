{% set moisFr = {1: 'janvier', 2: 'février', 3: 'mars', 4: 'avril', 5: 'mai', 6: 'juin', 7: 'juillet', 8: 'août', 9: 'septembre', 10: 'octobre', 11: 'novembre', 12: 'décembre'} %}
{% set memberSinceTs = (currentUser.created_at|default('now'))|date('U') %}
{% set memberSince = moisFr[memberSinceTs|date('n')] ~ ' ' ~ memberSinceTs|date('Y') %}

{% set clientNav = [
    {href: '/mon-compte', label: 'Tableau de bord', icon: 'M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6', ready: true},
    {href: '/mon-compte/transactions', label: 'Mes transactions', icon: 'M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14', ready: true},
    {href: '/mon-compte/avantages', label: 'Mes avantages', icon: 'M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z', ready: true},
    {href: '/mon-compte/offres', label: 'Mes offres', icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z', ready: true},
    {href: '/mon-compte/sondages', label: 'Sondages & Votes', icon: 'M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14', ready: true},
    {href: '/mon-compte/loterie', label: 'Loterie', icon: 'M12 8c-1.5-3-6-3-6 0s4.5 3 6 6c1.5-3 6-3 6-6s-4.5-3-6 0z', ready: true},
    {href: '/mon-compte/parrainage', label: 'Parrainage', icon: 'M17 20h5v-2a4 4 0 00-3-3.87M9 20H4v-2a4 4 0 013-3.87m6-1.13a4 4 0 10-4-4 4 4 0 004 4zm6 0a4 4 0 10-4-4', ready: true},
    {href: '/mon-compte/informations', label: 'Mes informations', icon: 'M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z', ready: true},
    {href: '/mon-compte/notifications', label: 'Notifications', icon: 'M15 17h5l-1.4-1.4A2 2 0 0118 14.2V11a6 6 0 10-12 0v3.2a2 2 0 01-.6 1.4L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9', ready: false},
    {href: '/mon-compte/aide', label: 'Aide & support', icon: 'M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z', ready: false},
] %}
<aside class="hidden lg:block">
  <div class="bg-white border border-gray-100 rounded-2xl p-5 mb-5">
    <div class="flex items-center gap-3 mb-1">
      <span class="w-11 h-11 rounded-full bg-brand-50 text-brand-500 flex items-center justify-center text-sm font-bold">
        {{ currentUser.first_name|slice(0, 1) }}{{ currentUser.last_name|slice(0, 1) }}
      </span>
      <div>
        <p class="font-bold text-ink text-sm">{{ currentUser.first_name }} {{ currentUser.last_name }}</p>
        <span class="inline-flex items-center gap-1 text-[11px] font-semibold text-amber-600 bg-amber-50 px-2 py-0.5 rounded-full mt-1">
          ⭐ {{ currentUser.segment == 'fidele' ? 'Client fidèle' : currentUser.segment|capitalize }}
        </span>
      </div>
    </div>
    <p class="text-xs text-gray-400 mt-2">Membre depuis {{ memberSince }}</p>
  </div>

  <nav class="bg-white border border-gray-100 rounded-2xl p-3 space-y-1">
    {% for item in clientNav %}
      {% set isActive = currentUri == item.href %}
      <a href="{{ base_path ~ item.href }}"
         class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors
                {{ isActive ? 'bg-brand-500 text-white' : 'text-gray-600 hover:bg-gray-50' }}">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-[18px] h-[18px] shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="{{ item.icon }}"/>
        </svg>
        <span class="flex-1">{{ item.label }}</span>
        {% if not item.ready %}
          <span class="text-[9px] font-bold uppercase tracking-wide bg-gray-100 text-gray-400 px-1.5 py-0.5 rounded">Bientôt</span>
        {% endif %}
      </a>
    {% endfor %}

    <form method="POST" action="{{ base_path }}/deconnexion" class="pt-1 mt-1 border-t border-gray-50">
      {{ csrf_field() }}
      <button type="submit" class="w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium text-gray-400 hover:bg-gray-50 hover:text-brand-500 transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-[18px] h-[18px]" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
        </svg>
        Déconnexion
      </button>
    </form>
  </nav>
</aside>
