<div class="w-full max-w-md bg-white border border-gray-100 rounded-2xl shadow-sm p-8">
  <h1 class="font-extrabold text-ink mb-1" style="font-size:22px; letter-spacing:-0.5px;">Choisir un mot de passe</h1>
  <p class="text-gray-500 mb-6" style="font-size:13px; letter-spacing:0.3px;">Cette étape vous permet d'accéder à votre espace client en toute sécurité.</p>

  {% if not valid %}
    <div class="flex items-start gap-2 bg-brand-50 text-brand-700 border border-brand-100 rounded-lg px-4 py-3 text-sm mb-5">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path stroke-linecap="round" d="M12 8v5M12 16h.01"/></svg>
      Ce lien est invalide ou a expiré.
    </div>

    <a href="{{ base_path }}/mot-de-passe-oublie" class="block w-full text-center bg-brand-500 hover:bg-brand-600 text-white font-bold text-sm px-6 py-3.5 rounded-lg transition-colors">
      Demander un nouveau lien
    </a>
  {% else %}
    {% if error %}
      <div class="flex items-start gap-2 bg-brand-50 text-brand-700 border border-brand-100 rounded-lg px-4 py-3 text-sm mb-5">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path stroke-linecap="round" d="M12 8v5M12 16h.01"/></svg>
        {{ error }}
      </div>
    {% endif %}

    <form method="POST" action="{{ base_path }}/reinitialiser-mot-de-passe/{{ token }}" class="space-y-4">
      {{ csrf_field() }}

      <div>
        <label class="block font-semibold text-ink mb-1.5" style="font-size:13px; letter-spacing:0.3px;">Nouveau mot de passe</label>
        <input type="password" name="password" required minlength="6" placeholder="••••••••" autofocus
               class="w-full bg-gray-50 border border-gray-100 rounded-lg px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500/30 focus:border-brand-500">
      </div>

      <div>
        <label class="block font-semibold text-ink mb-1.5" style="font-size:13px; letter-spacing:0.3px;">Confirmer le mot de passe</label>
        <input type="password" name="password_confirmation" required minlength="6" placeholder="••••••••"
               class="w-full bg-gray-50 border border-gray-100 rounded-lg px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500/30 focus:border-brand-500">
      </div>

      <button type="submit" class="w-full bg-brand-500 hover:bg-brand-600 text-white font-bold text-sm px-6 py-3.5 rounded-lg transition-colors">
        Valider et accéder à mon espace
      </button>
    </form>
  {% endif %}
</div>
