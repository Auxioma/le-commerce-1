} %}
{% set accents = {
  emerald: 'bg-emerald-50 text-emerald-600',
  blue:    'bg-blue-50 text-blue-600',
  brand:   'bg-brand-50 text-brand-600',
  amber:   'bg-amber-50 text-amber-600',
  purple:  'bg-purple-100 text-purple-700'
} %}

<div class="mb-8 flex items-end justify-between gap-4 flex-wrap">
  <div>
    <h1 class="font-extrabold text-3xl text-ink mb-2">Notifications</h1>
    <p class="text-gray-500">
      {% if total %}{{ total }} notification{{ total > 1 ? 's' : '' }} — messages, portefeuille, offres, loterie, sondages et parrainage.
      {% else %}Retrouvez ici toute l'activité de votre compte.{% endif %}
    </p>
  </div>
</div>

{% if groups is empty %}
  <div class="bg-white border border-gray-100 rounded-2xl p-12 text-center">
    <span class="w-16 h-16 rounded-full bg-gray-50 text-gray-300 flex items-center justify-center mx-auto mb-4">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="{{ icons.chat }}"/>
      </svg>
    </span>
    <p class="font-bold text-ink mb-1">Aucune notification pour le moment</p>
    <p class="text-gray-500 text-sm">Vos messages, offres et récompenses apparaîtront ici.</p>
  </div>
{% else %}
  <div class="space-y-8 max-w-2xl">
    {% for day, items in groups %}
      {% set dayLabel = day == today ? "Aujourd'hui" : (day == yesterday ? 'Hier' : day|date('d/m/Y')) %}
      <section>
        <h2 class="text-xs font-bold uppercase tracking-wide text-gray-400 mb-3">{{ dayLabel }}</h2>
        <div class="bg-white border border-gray-100 rounded-2xl divide-y divide-gray-50 overflow-hidden">
          {% for n in items %}
            {% set inner %}
              <span class="w-10 h-10 rounded-full shrink-0 flex items-center justify-center {{ accents[n.accent]|default('bg-gray-50 text-gray-500') }}">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="{{ icons[n.icon]|default(icons.chat) }}"/>
                </svg>
              </span>
              <div class="flex-1 min-w-0">
                <div class="flex items-start justify-between gap-3">
                  <p class="font-semibold text-ink text-sm">{{ n.title }}</p>
                  <time class="text-[11px] text-gray-400 shrink-0 mt-0.5">{{ n.date|date('H:i') }}</time>
                </div>
                {% if n.body %}<p class="text-gray-500 text-sm mt-0.5">{{ n.body }}</p>{% endif %}
              </div>
            {% endset %}

            {% if n.url %}
              <a href="{{ base_path ~ n.url }}" class="flex items-start gap-3 p-4 hover:bg-gray-50 transition-colors">{{ inner }}</a>
            {% else %}
              <div class="flex items-start gap-3 p-4">{{ inner }}</div>
            {% endif %}
          {% endfor %}
        </div>
      </section>
    {% endfor %}
  </div>
{% endif %}
