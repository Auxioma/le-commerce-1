<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title|default(shop.name) }}</title>
<meta name="robots" content="noindex, nofollow">
<link rel="icon" type="image/svg+xml" href="{{ base_path }}/favicon.svg">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800;900&family=Pacifico&display=swap" rel="stylesheet">
<link rel="stylesheet" href="{{ asset_version('assets/css/app.css') }}">
</head>
<body class="bg-slate-100 text-ink antialiased font-sans">

<div class="min-h-screen">
  <div class="flex min-h-screen">
    {% include 'partials/admin-sidebar.twig' %}

    <div class="flex-1 min-w-0 flex flex-col">
      {% include 'partials/admin-topbar.twig' %}
      {% include 'partials/flash.twig' %}

      <main class="flex-1 p-6 lg:p-8">
        <div class="mx-auto w-full max-w-[1720px]">
          {{ content|raw }}
        </div>
      </main>
    </div>
  </div>
</div>

<script src="{{ base_path }}/assets/js/app.js"></script>
</body>
</html>
