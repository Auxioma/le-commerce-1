{% set segmentLabels = {'fidele': 'Fidèle', 'nouveau': 'Nouveau', 'occasionnel': 'Occasionnel'} %}
{% set avatarColors  = ['bg-blue-500', 'bg-purple-500', 'bg-green-500', 'bg-orange-500', 'bg-pink-500', 'bg-teal-500'] %}
{% set colorIdx = hash_mod(client.first_name, avatarColors|length) %}
{% set initials = (client.first_name|slice(0, 1) ~ client.last_name|slice(0, 1))|upper %}

{% set typeLabels = {'recharge': 'Recharge', 'debit': 'Débit', 'remboursement': 'Remboursement'} %}
{% set typeStyles = {'recharge': 'bg-green-100 text-green-800', 'debit': 'bg-red-100 text-red-700', 'remboursement': 'bg-blue-100 text-blue-800'} %}

<!-- Fil d'ariane -->
<a href="{{ base_path }}/admin/clients" class="inline-flex items-center gap-2 text-gray-500 hover:text-ink transition-colors mb-4" style="font-size:13px; font-weight:600;">
  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
  Retour aux clients
</a>

<!-- En-tête -->
<div class="flex items-start justify-between mb-6 gap-4 flex-wrap">
  <div class="flex items-center gap-4">
    <div class="w-14 h-14 rounded-full {{ avatarColors[colorIdx] }} flex items-center justify-center shrink-0">
      <span class="text-white font-bold" style="font-size:18px;">{{ initials }}</span>
    </div>
    <div>
      <h1 class="font-extrabold text-ink" style="font-size:22px; letter-spacing:-0.5px;">
        {{ client.first_name }} {{ client.last_name }}
      </h1>
      <div class="flex items-center gap-2 mt-1.5">
        <span class="px-2.5 py-1 rounded-full font-semibold {{ client.status == 'actif' ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-500' }}" style="font-size:11.5px;">
          {{ client.status == 'actif' ? 'Actif' : 'Inactif' }}
        </span>
        <span class="px-2.5 py-1 rounded-full font-semibold bg-gray-100 text-gray-700" style="font-size:11.5px;">
          {{ segmentLabels[client.segment]|default(client.segment) }}
        </span>
        <span class="text-gray-400" style="font-size:12px;">Client depuis le {{ client.created_at|date('d/m/Y') }}</span>
      </div>
    </div>
  </div>
</div>

<div class="grid lg:grid-cols-[1.3fr_0.7fr] gap-5 items-start">

  <!-- Colonne gauche -->
  <div class="space-y-5">

    <!-- Informations -->
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-5">
      <h2 class="font-bold text-ink mb-4" style="font-size:15px;">Informations du client</h2>
      <form method="POST" action="{{ base_path }}/admin/clients/{{ client.id }}" class="space-y-4">
        {{ csrf_field() }}
        <div class="grid sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-semibold text-ink mb-1.5">Prénom</label>
            <input type="text" name="first_name" required value="{{ client.first_name }}" class="form-input">
          </div>
          <div>
            <label class="block text-sm font-semibold text-ink mb-1.5">Nom</label>
            <input type="text" name="last_name" required value="{{ client.last_name }}" class="form-input">
          </div>
        </div>
        <div class="grid sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-semibold text-ink mb-1.5">Téléphone WhatsApp</label>
            <input type="text" name="phone_whatsapp" required value="{{ client.phone_whatsapp }}" class="form-input">
          </div>
          <div>
            <label class="block text-sm font-semibold text-ink mb-1.5">E-mail</label>
            <input type="email" name="email" value="{{ client.email|default('') }}" class="form-input">
          </div>
        </div>
        <div class="grid sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-semibold text-ink mb-1.5">Segment</label>
            <select name="segment" class="form-select">
              {% for key, label in segmentLabels %}
                <option value="{{ key }}" {{ client.segment == key ? 'selected' : '' }}>{{ label }}</option>
              {% endfor %}
            </select>
          </div>
          <div>
            <label class="block text-sm font-semibold text-ink mb-1.5">Statut du compte</label>
            <select name="status" class="form-select">
              <option value="actif"   {{ client.status == 'actif' ? 'selected' : '' }}>Actif</option>
              <option value="inactif" {{ client.status == 'inactif' ? 'selected' : '' }}>Inactif</option>
            </select>
          </div>
        </div>
        <button type="submit" class="btn-primary">Enregistrer les modifications</button>
      </form>
    </div>

    <!-- Historique des transactions -->
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
      <div class="px-5 py-4 border-b border-gray-100">
        <h2 class="font-bold text-ink" style="font-size:15px;">Historique du portefeuille</h2>
      </div>
      {% if transactions.data is empty %}
        <div class="text-center py-10 px-6">
          <p class="text-gray-500 text-sm">Aucune transaction pour ce client.</p>
        </div>
      {% else %}
        <div class="overflow-x-auto">
          <table class="min-w-full">
            <thead class="bg-gray-50 border-b border-gray-100">
              <tr>
                <th class="px-5 py-2.5 text-left font-bold text-gray-500 uppercase" style="font-size:10.5px; letter-spacing:0.5px;">Date</th>
                <th class="px-5 py-2.5 text-left font-bold text-gray-500 uppercase" style="font-size:10.5px; letter-spacing:0.5px;">Type</th>
                <th class="px-5 py-2.5 text-left font-bold text-gray-500 uppercase" style="font-size:10.5px; letter-spacing:0.5px;">Détail</th>
                <th class="px-5 py-2.5 text-right font-bold text-gray-500 uppercase" style="font-size:10.5px; letter-spacing:0.5px;">Montant</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-50">
              {% for tx in transactions.data %}
                <tr>
                  <td class="px-5 py-3 whitespace-nowrap text-gray-500" style="font-size:12.5px;">{{ tx.created_at|date('d/m/Y H:i') }}</td>
                  <td class="px-5 py-3 whitespace-nowrap">
                    <span class="px-2 py-0.5 rounded-full font-semibold {{ typeStyles[tx.type]|default('bg-gray-100 text-gray-700') }}" style="font-size:11px;">
                      {{ typeLabels[tx.type]|default(tx.type) }}
                    </span>
                  </td>
                  <td class="px-5 py-3 text-gray-600" style="font-size:12.5px;">{{ tx.label|default('—') }}</td>
                  <td class="px-5 py-3 whitespace-nowrap text-right font-bold" style="font-size:12.5px; color:{{ tx.type == 'debit' ? '#c8272c' : '#16a34a' }};">
                    {{ tx.type == 'debit' ? '-' : '+' }}{{ tx.amount|number_format(2, ',', ' ') }} €
                  </td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
        {% if transactions.totalPages > 1 %}
          <div class="flex items-center gap-1.5 px-5 py-3 border-t border-gray-100 bg-gray-50">
            {% for p in 1..transactions.totalPages %}
              <a href="{{ base_path }}/admin/clients/{{ client.id }}?page={{ p }}"
                 class="w-8 h-8 flex items-center justify-center rounded-lg font-bold transition-colors"
                 style="font-size:12.5px; {{ p == transactions.page ? 'background:#c8272c; color:#fff;' : 'color:#6b7280;' }}">
                {{ p }}
              </a>
            {% endfor %}
          </div>
        {% endif %}
      {% endif %}
    </div>

    <!-- Zone de danger -->
    <div class="bg-white border border-red-100 rounded-xl shadow-sm p-5">
      <h2 class="font-bold mb-1" style="font-size:15px; color:#c8272c;">Zone de danger</h2>
      <p class="text-gray-500 text-sm mb-4">La suppression du compte est définitive et effacera aussi son portefeuille et son historique.</p>
      <form method="POST" action="{{ base_path }}/admin/clients/{{ client.id }}/supprimer"
            onsubmit="return confirm('Supprimer définitivement {{ (client.first_name ~ ' ' ~ client.last_name)|e('js') }} ? Cette action est irréversible.');">
        {{ csrf_field() }}
        <button type="submit" class="inline-flex items-center gap-2 font-bold px-4 py-2.5 rounded-lg border transition-colors hover:bg-red-50" style="font-size:13px; color:#c8272c; border-color:#fecaca;">
          Supprimer ce client
        </button>
      </form>
    </div>
  </div>

  <!-- Colonne droite -->
  <div class="space-y-5">

    <!-- Portefeuille -->
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-5">
      <p class="text-gray-500 font-semibold" style="font-size:12px;">Solde du portefeuille</p>
      <p class="font-black text-ink mb-1" style="font-size:30px;">{{ (wallet.balance|default(0))|number_format(2, ',', ' ') }} €</p>
      <p class="text-gray-400 mb-4" style="font-size:11.5px;">Le client paie en caisse, créditez le montant reçu ici.</p>

      <form method="POST" action="{{ base_path }}/admin/clients/{{ client.id }}/wallet" class="space-y-3">
        {{ csrf_field() }}
        <div class="grid grid-cols-2 gap-2">
          <label class="flex items-center justify-center gap-2 border border-gray-200 rounded-lg py-2 cursor-pointer has-[:checked]:border-brand-500 has-[:checked]:bg-brand-50" style="font-size:12.5px; font-weight:600;">
            <input type="radio" name="direction" value="credit" checked class="accent-brand-500"> Créditer
          </label>
          <label class="flex items-center justify-center gap-2 border border-gray-200 rounded-lg py-2 cursor-pointer has-[:checked]:border-brand-500 has-[:checked]:bg-brand-50" style="font-size:12.5px; font-weight:600;">
            <input type="radio" name="direction" value="debit" class="accent-brand-500"> Débiter
          </label>
        </div>
        <input type="number" name="amount" step="0.01" min="0.01" required placeholder="Montant en €" class="form-input">
        <select name="payment_method" class="form-select">
          <option value="especes">Payé en espèces</option>
          <option value="carte_bancaire">Payé par carte</option>
        </select>
        <input type="text" name="label" placeholder="Motif (optionnel)" class="form-input">
        <p class="text-gray-400" style="font-size:11px;">🎁 Une recharge de 50 € déclenche automatiquement +2 € de bonus fidélité.</p>
        <button type="submit" class="btn-primary w-full">Appliquer l'ajustement</button>
      </form>
    </div>

    <!-- Statistiques rapides -->
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-5 space-y-3">
      <div class="flex items-center justify-between">
        <p class="text-gray-500" style="font-size:12.5px;">Points fidélité</p>
        <p class="font-bold text-ink" style="font-size:13px;">{{ client.loyalty_points }} pts</p>
      </div>
      <div class="flex items-center justify-between">
        <p class="text-gray-500" style="font-size:12.5px;">Filleuls parrainés</p>
        <p class="font-bold text-ink" style="font-size:13px;">{{ referralsCount }}</p>
      </div>
      <div class="flex items-center justify-between">
        <p class="text-gray-500" style="font-size:12.5px;">Code de parrainage</p>
        <p class="font-bold text-ink" style="font-size:13px;">{{ client.referral_code|default('—') }}</p>
      </div>
      <div class="flex items-center justify-between">
        <p class="text-gray-500" style="font-size:12.5px;">Géolocalisation</p>
        <p class="font-bold text-ink" style="font-size:13px;">{{ client.geolocation_opt_in ? 'Activée' : 'Désactivée' }}</p>
      </div>
    </div>
  </div>
</div>
