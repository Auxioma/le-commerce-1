{% set pageTitle = 'Galerie photos' %}
{% set pageSubtitle = "Organisez vos photos en catégories (filtres) puis en galeries. Elles alimentent le bloc « Le Commerce en images » de l'accueil et la page publique /galerie." %}
{% set pageActions = [
    {href: base_path ~ '/galerie', label: 'Voir la galerie', class: 'btn-secondary'},
    {href: base_path ~ '/admin/galerie/categories/creer', label: 'Nouvelle catégorie', class: 'btn-secondary'},
    {href: base_path ~ '/admin/galerie/albums/creer', label: 'Nouvelle galerie', class: 'btn-primary'},
] %}
{% include 'partials/admin-page-header.twig' %}

<!-- KPIs -->
<div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5 mb-6">
  <div class="card card-md">
    <p class="text-sm font-semibold text-gray-500 mb-2">Galeries publiées</p>
    <p class="font-extrabold text-3xl text-ink">{{ activeGalleriesCount }}</p>
    <p class="text-xs text-gray-400 mt-1">Sur {{ galleries|length }} galerie{{ galleries|length > 1 ? 's' : '' }} au total</p>
  </div>
  <div class="card card-md">
    <p class="text-sm font-semibold text-gray-500 mb-2">Photos publiées</p>
    <p class="font-extrabold text-3xl text-ink">{{ photosCount }}</p>
    <p class="text-xs text-gray-400 mt-1">Toutes galeries confondues</p>
  </div>
  <div class="card card-md">
    <p class="text-sm font-semibold text-gray-500 mb-2">Catégories</p>
    <p class="font-extrabold text-3xl text-ink">{{ categories|length }}</p>
    <p class="text-xs text-gray-400 mt-1">Filtres « Au bar », « Matchs »…</p>
  </div>
</div>

<!-- =====================  GALERIES  ===================== -->
<div class="card overflow-hidden mb-6">
  <div class="px-5 py-4 border-b border-gray-50 flex items-center justify-between gap-3">
    <div>
      <h2 class="font-bold text-ink">Galeries</h2>
      <p class="text-sm text-gray-500 mt-0.5">Cliquez sur une galerie pour gérer ses photos.</p>
    </div>
    <a href="{{ base_path }}/admin/galerie/albums/creer" class="btn-primary shrink-0">Nouvelle galerie</a>
  </div>
  {% if galleries is empty %}
    <div class="text-center py-16 px-6">
      <p class="text-gray-500 font-medium mb-1">Aucune galerie pour le moment.</p>
      <a href="{{ base_path }}/admin/galerie/albums/creer" class="text-brand-500 text-sm font-semibold hover:underline">Créer votre première galerie</a>
    </div>
  {% else %}
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="bg-gray-50">
          <tr class="text-left text-gray-500 text-xs uppercase tracking-wide">
            <th class="px-5 py-3 font-semibold">Galerie</th>
            <th class="px-5 py-3 font-semibold">Catégorie</th>
            <th class="px-5 py-3 font-semibold">Photos</th>
            <th class="px-5 py-3 font-semibold">Date</th>
            <th class="px-5 py-3 font-semibold">Statut</th>
            <th class="px-5 py-3 font-semibold text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-50">
          {% for gallery in galleries %}
            <tr class="hover:bg-gray-50/50">
              <td class="px-5 py-3.5">
                <a href="{{ base_path }}/admin/galerie/albums/{{ gallery.id }}" class="flex items-center gap-3 group">
                  {% if gallery.cover_image %}
                    <img src="{{ base_path }}{{ gallery.cover_image }}" alt="" class="w-14 h-14 rounded-xl object-cover shrink-0">
                  {% else %}
                    <span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-xl bg-brand-50 text-brand-500">
                      <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.6-4.6a2 2 0 012.8 0L16 16m-2-2l1.6-1.6a2 2 0 012.8 0L20 14M14 8h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                    </span>
                  {% endif %}
                  <div class="min-w-0">
                    <p class="font-semibold text-ink truncate max-w-[260px] group-hover:text-brand-500">{{ gallery.title }}</p>
                    {% if gallery.description %}<p class="text-xs text-gray-400 truncate max-w-[260px]">{{ gallery.description }}</p>{% endif %}
                  </div>
                </a>
              </td>
              <td class="px-5 py-3.5 text-gray-500">{{ gallery.category_name|default('—') }}</td>
              <td class="px-5 py-3.5 text-gray-500">{{ gallery.published_count }}{% if gallery.photos_count != gallery.published_count %} <span class="text-gray-400">/ {{ gallery.photos_count }}</span>{% endif %}</td>
              <td class="px-5 py-3.5 text-gray-500">{{ gallery.event_date|date('d/m/Y') }}</td>
              <td class="px-5 py-3.5">
                {% if gallery.status != 'active' %}
                  <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-gray-100 text-gray-500">Masquée</span>
                {% elseif gallery.published_count == 0 %}
                  <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-amber-50 text-amber-600">Sans photo</span>
                {% else %}
                  <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-600">Publiée</span>
                {% endif %}
              </td>
              <td class="px-5 py-3.5 text-right">
                <div class="inline-flex items-center gap-3">
                  <a href="{{ base_path }}/admin/galerie/albums/{{ gallery.id }}" class="text-xs font-bold text-gray-500 hover:text-brand-500">Photos</a>
                  <a href="{{ base_path }}/admin/galerie/albums/{{ gallery.id }}/modifier" class="text-xs font-bold text-gray-500 hover:text-brand-500">Modifier</a>
                  <form method="POST" action="{{ base_path }}/admin/galerie/albums/{{ gallery.id }}/statut" class="inline">
                    {{ csrf_field() }}
                    <button type="submit" class="text-xs font-bold text-gray-500 hover:text-brand-500">
                      {{ gallery.status == 'active' ? 'Masquer' : 'Publier' }}
                    </button>
                  </form>
                  <form method="POST" action="{{ base_path }}/admin/galerie/albums/{{ gallery.id }}/supprimer" class="inline"
                        onsubmit="return confirm('Supprimer cette galerie ET toutes ses photos ?');">
                    {{ csrf_field() }}
                    <button type="submit" class="text-xs font-bold text-brand-500 hover:text-brand-600">Supprimer</button>
                  </form>
                </div>
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  {% endif %}
</div>

<!-- =====================  CATÉGORIES  ===================== -->
<div class="card overflow-hidden max-w-3xl">
  <div class="px-5 py-4 border-b border-gray-50 flex items-center justify-between gap-3">
    <div>
      <h2 class="font-bold text-ink">Catégories (filtres)</h2>
      <p class="text-sm text-gray-500 mt-0.5">Côté public, seules les catégories qui contiennent des photos publiées apparaissent.</p>
    </div>
    <a href="{{ base_path }}/admin/galerie/categories/creer" class="btn-primary shrink-0">Nouvelle catégorie</a>
  </div>
  {% if categories is empty %}
    <div class="text-center py-16 px-6">
      <p class="text-gray-500 font-medium mb-1">Aucune catégorie : seul le filtre « Tous » est affiché.</p>
      <a href="{{ base_path }}/admin/galerie/categories/creer" class="text-brand-500 text-sm font-semibold hover:underline">Créer une catégorie</a>
    </div>
  {% else %}
    <ul class="divide-y divide-gray-50">
      {% for category in categories %}
        <li class="flex items-center justify-between gap-3 px-5 py-3">
          <div class="flex items-center gap-3 min-w-0">
            <span class="text-xs font-bold text-gray-400 w-6 text-right">{{ category.display_order }}</span>
            <p class="font-semibold text-ink text-sm">{{ category.name }}</p>
            <span class="text-xs text-gray-400">{{ category.galleries_count }} galerie{{ category.galleries_count > 1 ? 's' : '' }}</span>
            {% if category.status != 'active' %}
              <span class="text-xs font-semibold px-2 py-0.5 rounded-full bg-gray-100 text-gray-500">Inactive</span>
            {% endif %}
          </div>
          <div class="inline-flex items-center gap-3 shrink-0">
            <a href="{{ base_path }}/admin/galerie/albums/creer?categorie={{ category.id }}" class="text-xs font-bold text-gray-500 hover:text-brand-500">+ Galerie</a>
            <a href="{{ base_path }}/admin/galerie/categories/{{ category.id }}/modifier" class="text-xs font-bold text-gray-500 hover:text-brand-500">Modifier</a>
            <form method="POST" action="{{ base_path }}/admin/galerie/categories/{{ category.id }}/statut" class="inline">
              {{ csrf_field() }}
              <button type="submit" class="text-xs font-bold text-gray-500 hover:text-brand-500">
                {{ category.status == 'active' ? 'Désactiver' : 'Activer' }}
              </button>
            </form>
            <form method="POST" action="{{ base_path }}/admin/galerie/categories/{{ category.id }}/supprimer" class="inline"
                  onsubmit="return confirm('Supprimer cette catégorie ? Ses galeries seront conservées, sans catégorie.');">
              {{ csrf_field() }}
              <button type="submit" class="text-xs font-bold text-brand-500 hover:text-brand-600">Supprimer</button>
            </form>
          </div>
        </li>
      {% endfor %}
    </ul>
  {% endif %}
</div>
