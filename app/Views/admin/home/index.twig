{% set pageTitle = 'Page principale' %}
{% set pageSubtitle = "Gérez tous les textes, catégories et listes affichés sur la page d'accueil publique (/). Les photos se gèrent depuis Contenu du site." %}
{% set pageActions = [
    {href: base_path ~ '/admin/images', label: 'Photos du site', class: 'btn-secondary'},
    {href: base_path ~ '/', label: 'Voir la page publique', class: 'btn-primary'},
] %}
{% include 'partials/admin-page-header.twig' %}

<!-- =====================  HERO  ===================== -->
<div class="card overflow-hidden mb-6">
  <div class="px-5 py-4 border-b border-gray-50">
    <h2 class="font-bold text-ink">Bandeau d'accueil (hero)</h2>
    <p class="text-sm text-gray-500 mt-0.5">Texte affiché sur la grande bannière en haut de la page d'accueil.</p>
  </div>
  <form method="POST" action="{{ base_path }}/admin/page-principale/contenu" class="p-5 space-y-4">
    {{ csrf_field() }}
    <div>
      <label class="block text-sm font-semibold text-ink mb-1.5">Badge (au-dessus du titre)</label>
      <input type="text" name="home_hero_badge" value="{{ content.home_hero_badge }}" class="form-input">
    </div>
    <div class="grid sm:grid-cols-2 gap-4">
      <div>
        <label class="block text-sm font-semibold text-ink mb-1.5">Titre principal</label>
        <input type="text" name="home_hero_title" value="{{ content.home_hero_title }}" class="form-input">
      </div>
      <div>
        <label class="block text-sm font-semibold text-ink mb-1.5">Sous-titre</label>
        <input type="text" name="home_hero_subtitle" value="{{ content.home_hero_subtitle }}" class="form-input">
      </div>
    </div>
    <div>
      <label class="block text-sm font-semibold text-ink mb-1.5">Signature (police manuscrite)</label>
      <input type="text" name="home_hero_tagline" value="{{ content.home_hero_tagline }}" class="form-input">
    </div>
    <div>
      <label class="block text-sm font-semibold text-ink mb-1.5">Description</label>
      <textarea name="home_hero_description" rows="2" class="form-textarea">{{ content.home_hero_description }}</textarea>
    </div>
    <div class="grid sm:grid-cols-2 gap-4">
      <div class="flex gap-3">
        <div class="flex-1">
          <label class="block text-sm font-semibold text-ink mb-1.5">Bouton 1 — texte</label>
          <input type="text" name="home_hero_btn1_label" value="{{ content.home_hero_btn1_label }}" class="form-input">
        </div>
        <div class="flex-1">
          <label class="block text-sm font-semibold text-ink mb-1.5">Bouton 1 — lien</label>
          <input type="text" name="home_hero_btn1_link" value="{{ content.home_hero_btn1_link }}" class="form-input">
        </div>
      </div>
      <div class="flex gap-3">
        <div class="flex-1">
          <label class="block text-sm font-semibold text-ink mb-1.5">Bouton 2 — texte</label>
          <input type="text" name="home_hero_btn2_label" value="{{ content.home_hero_btn2_label }}" class="form-input">
        </div>
        <div class="flex-1">
          <label class="block text-sm font-semibold text-ink mb-1.5">Bouton 2 — lien</label>
          <input type="text" name="home_hero_btn2_link" value="{{ content.home_hero_btn2_link }}" class="form-input">
        </div>
      </div>
    </div>
    <button type="submit" class="btn-primary">Enregistrer le hero</button>
  </form>
</div>

<!-- =====================  CATÉGORIES  ===================== -->
<div class="card overflow-hidden mb-6">
  <div class="px-5 py-4 border-b border-gray-50 flex items-center justify-between gap-3">
    <div>
      <h2 class="font-bold text-ink">Tuiles de catégories</h2>
      <p class="text-sm text-gray-500 mt-0.5">Rangée de tuiles juste sous le hero (Le Bar, Tabac, PMU...).</p>
    </div>
    <a href="{{ base_path }}/admin/page-principale/categories/creer" class="btn-primary shrink-0">Ajouter une catégorie</a>
  </div>
  {% if categories is empty %}
    <div class="text-center py-16 px-6">
      <p class="text-gray-500 font-medium mb-1">Aucune catégorie pour le moment.</p>
      <a href="{{ base_path }}/admin/page-principale/categories/creer" class="text-brand-500 text-sm font-semibold hover:underline">Ajouter votre première catégorie</a>
    </div>
  {% else %}
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="bg-gray-50">
          <tr class="text-left text-gray-500 text-xs uppercase tracking-wide">
            <th class="px-5 py-3 font-semibold">Catégorie</th>
            <th class="px-5 py-3 font-semibold">Description</th>
            <th class="px-5 py-3 font-semibold">Lien</th>
            <th class="px-5 py-3 font-semibold">Statut</th>
            <th class="px-5 py-3 font-semibold text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-50">
          {% for category in categories %}
            <tr class="hover:bg-gray-50/50">
              <td class="px-5 py-3.5">
                <div class="flex items-center gap-3">
                  <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-brand-50 text-brand-500">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">{{ category.icon|raw }}</svg>
                  </span>
                  <p class="font-semibold text-ink">{{ category.name }}</p>
                </div>
              </td>
              <td class="px-5 py-3.5 text-gray-500 max-w-[280px] truncate">{{ category.description|default('') }}</td>
              <td class="px-5 py-3.5 text-gray-500 font-mono text-xs">{{ category.link }}</td>
              <td class="px-5 py-3.5">
                {% if category.status == 'active' %}
                  <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-600">Active</span>
                {% else %}
                  <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-gray-100 text-gray-500">Inactive</span>
                {% endif %}
              </td>
              <td class="px-5 py-3.5 text-right">
                <div class="inline-flex items-center gap-3">
                  <a href="{{ base_path }}/admin/page-principale/categories/{{ category.id }}/modifier" class="text-xs font-bold text-gray-500 hover:text-brand-500">Modifier</a>
                  <form method="POST" action="{{ base_path }}/admin/page-principale/categories/{{ category.id }}/statut" class="inline">
                    {{ csrf_field() }}
                    <button type="submit" class="text-xs font-bold text-gray-500 hover:text-brand-500">
                      {{ category.status == 'active' ? 'Désactiver' : 'Activer' }}
                    </button>
                  </form>
                  <form method="POST" action="{{ base_path }}/admin/page-principale/categories/{{ category.id }}/supprimer" class="inline"
                        onsubmit="return confirm('Supprimer définitivement cette catégorie ?');">
                    {{ csrf_field() }}
                    <button type="submit" class="text-xs font-bold text-brand-500 hover:text-brand-600">Supprimer</button>
                  </form>
                </div>
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  {% endif %}
</div>

<!-- =====================  CARTES  ===================== -->
<div class="card overflow-hidden mb-6">
  <div class="px-5 py-4 border-b border-gray-50">
    <h2 class="font-bold text-ink">Cartes de la section centrale</h2>
    <p class="text-sm text-gray-500 mt-0.5">Bières, planche à saucisson, WhatsApp et services du quotidien.</p>
  </div>
  <form method="POST" action="{{ base_path }}/admin/page-principale/contenu" class="p-5 space-y-6">
    {{ csrf_field() }}

    <div>
      <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-3">Nos bières</p>
      <div class="grid sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-semibold text-ink mb-1.5">Titre</label>
          <input type="text" name="home_beers_title" value="{{ content.home_beers_title }}" class="form-input">
        </div>
        <div>
          <label class="block text-sm font-semibold text-ink mb-1.5">Texte du bouton</label>
          <input type="text" name="home_beers_button_label" value="{{ content.home_beers_button_label }}" class="form-input">
        </div>
      </div>
    </div>

    <div class="border-t border-gray-100 pt-5">
      <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-3">Planche à saucisson</p>
      <div class="space-y-4">
        <div class="grid sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-semibold text-ink mb-1.5">Titre</label>
            <input type="text" name="home_saucisson_title" value="{{ content.home_saucisson_title }}" class="form-input">
          </div>
          <div>
            <label class="block text-sm font-semibold text-ink mb-1.5">Texte du bouton</label>
            <input type="text" name="home_saucisson_button_label" value="{{ content.home_saucisson_button_label }}" class="form-input">
          </div>
        </div>
        <div>
          <label class="block text-sm font-semibold text-ink mb-1.5">Description</label>
          <textarea name="home_saucisson_description" rows="2" class="form-textarea">{{ content.home_saucisson_description }}</textarea>
        </div>
      </div>
    </div>

    <div class="border-t border-gray-100 pt-5">
      <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-3">WhatsApp</p>
      <div class="space-y-4">
        <div class="grid sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-semibold text-ink mb-1.5">Titre <span class="text-gray-400 font-normal">(HTML autorisé, ex: &lt;br&gt;)</span></label>
            <input type="text" name="home_whatsapp_title" value="{{ content.home_whatsapp_title }}" class="form-input">
          </div>
          <div>
            <label class="block text-sm font-semibold text-ink mb-1.5">Texte du bouton</label>
            <input type="text" name="home_whatsapp_button_label" value="{{ content.home_whatsapp_button_label }}" class="form-input">
          </div>
        </div>
        <div>
          <label class="block text-sm font-semibold text-ink mb-1.5">Description</label>
          <textarea name="home_whatsapp_description" rows="2" class="form-textarea">{{ content.home_whatsapp_description }}</textarea>
        </div>
      </div>
    </div>

    <div class="border-t border-gray-100 pt-5">
      <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-3">Carte "Tous vos services"</p>
      <div class="grid sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-semibold text-ink mb-1.5">Titre <span class="text-gray-400 font-normal">(HTML autorisé)</span></label>
          <input type="text" name="home_services_card_title" value="{{ content.home_services_card_title }}" class="form-input">
        </div>
        <div>
          <label class="block text-sm font-semibold text-ink mb-1.5">Texte du bouton</label>
          <input type="text" name="home_services_card_button_label" value="{{ content.home_services_card_button_label }}" class="form-input">
        </div>
      </div>
    </div>

    <button type="submit" class="btn-primary">Enregistrer les cartes</button>
  </form>
</div>

<!-- =====================  SERVICES DU QUOTIDIEN  ===================== -->
<div class="card overflow-hidden mb-6 max-w-2xl">
  <div class="px-5 py-4 border-b border-gray-50 flex items-center justify-between gap-3">
    <div>
      <h2 class="font-bold text-ink">Liste "Tous vos services du quotidien"</h2>
      <p class="text-sm text-gray-500 mt-0.5">Affichée dans la carte dédiée de la page d'accueil.</p>
    </div>
    <a href="{{ base_path }}/admin/page-principale/services/creer" class="btn-primary shrink-0">Ajouter un service</a>
  </div>
  {% if quickServices is empty %}
    <div class="text-center py-16 px-6">
      <p class="text-gray-500 font-medium mb-1">Aucun service pour le moment.</p>
      <a href="{{ base_path }}/admin/page-principale/services/creer" class="text-brand-500 text-sm font-semibold hover:underline">Ajouter votre premier service</a>
    </div>
  {% else %}
    <ul class="divide-y divide-gray-50">
      {% for service in quickServices %}
        <li class="flex items-center justify-between gap-3 px-5 py-3">
          <div class="flex items-center gap-3">
            <span class="w-3 h-3 rounded-full shrink-0" style="background:{{ service.color }};"></span>
            <p class="font-semibold text-ink text-sm">{{ service.label }}</p>
            {% if service.status != 'active' %}
              <span class="text-xs font-semibold px-2 py-0.5 rounded-full bg-gray-100 text-gray-500">Inactif</span>
            {% endif %}
          </div>
          <div class="inline-flex items-center gap-3 shrink-0">
            <a href="{{ base_path }}/admin/page-principale/services/{{ service.id }}/modifier" class="text-xs font-bold text-gray-500 hover:text-brand-500">Modifier</a>
            <form method="POST" action="{{ base_path }}/admin/page-principale/services/{{ service.id }}/statut" class="inline">
              {{ csrf_field() }}
              <button type="submit" class="text-xs font-bold text-gray-500 hover:text-brand-500">
                {{ service.status == 'active' ? 'Désactiver' : 'Activer' }}
              </button>
            </form>
            <form method="POST" action="{{ base_path }}/admin/page-principale/services/{{ service.id }}/supprimer" class="inline"
                  onsubmit="return confirm('Supprimer définitivement ce service ?');">
              {{ csrf_field() }}
              <button type="submit" class="text-xs font-bold text-brand-500 hover:text-brand-600">Supprimer</button>
            </form>
          </div>
        </li>
      {% endfor %}
    </ul>
  {% endif %}
</div>

<!-- =====================  COLONNE D'INFOS  ===================== -->
<div class="card overflow-hidden mb-6">
  <div class="px-5 py-4 border-b border-gray-50">
    <h2 class="font-bold text-ink">Rangée d'informations</h2>
    <p class="text-sm text-gray-500 mt-0.5">Avis Google, bons plans, météo et assistant.</p>
  </div>
  <form method="POST" action="{{ base_path }}/admin/page-principale/contenu" class="p-5 space-y-6">
    {{ csrf_field() }}

    <div>
      <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-3">Avis Google</p>
      <div class="grid sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-semibold text-ink mb-1.5">Titre</label>
          <input type="text" name="home_avis_title" value="{{ content.home_avis_title }}" class="form-input">
        </div>
        <div>
          <label class="block text-sm font-semibold text-ink mb-1.5">Texte du bouton</label>
          <input type="text" name="home_avis_button_label" value="{{ content.home_avis_button_label }}" class="form-input">
        </div>
      </div>
      <p class="text-xs text-gray-400 mt-2">La note et le nombre d'avis viennent automatiquement de Google (voir Avis).</p>
    </div>

    <div class="border-t border-gray-100 pt-5">
      <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-3">Bons plans</p>
      <div class="grid sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-semibold text-ink mb-1.5">Titre <span class="text-gray-400 font-normal">(HTML autorisé)</span></label>
          <input type="text" name="home_deals_title" value="{{ content.home_deals_title }}" class="form-input">
        </div>
        <div>
          <label class="block text-sm font-semibold text-ink mb-1.5">Texte du bouton</label>
          <input type="text" name="home_deals_button_label" value="{{ content.home_deals_button_label }}" class="form-input">
        </div>
      </div>
      <div class="mt-4">
        <label class="block text-sm font-semibold text-ink mb-1.5">Texte si aucune offre en cours</label>
        <input type="text" name="home_deals_empty_text" value="{{ content.home_deals_empty_text }}" class="form-input">
      </div>
      <p class="text-xs text-gray-400 mt-2">L'offre en cours elle-même se gère depuis <a href="{{ base_path }}/admin/offres" class="text-brand-500 font-semibold hover:underline">Marketing / Offres</a>.</p>
    </div>

    <div class="border-t border-gray-100 pt-5">
      <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-3">Météo</p>
      <div class="grid sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-semibold text-ink mb-1.5">Titre <span class="text-gray-400 font-normal">(ville ajoutée automatiquement)</span></label>
          <input type="text" name="home_weather_title" value="{{ content.home_weather_title }}" class="form-input">
        </div>
        <div>
          <label class="block text-sm font-semibold text-ink mb-1.5">Texte en bas de carte</label>
          <input type="text" name="home_weather_footer_text" value="{{ content.home_weather_footer_text }}" class="form-input">
        </div>
      </div>
    </div>

    <div class="border-t border-gray-100 pt-5">
      <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-3">Assistant</p>
      <div class="grid sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-semibold text-ink mb-1.5">Titre</label>
          <input type="text" name="home_assistant_title" value="{{ content.home_assistant_title }}" class="form-input">
        </div>
        <div>
          <label class="block text-sm font-semibold text-ink mb-1.5">Texte du champ de saisie</label>
          <input type="text" name="home_assistant_placeholder" value="{{ content.home_assistant_placeholder }}" class="form-input">
        </div>
      </div>
      <div class="mt-4">
        <label class="block text-sm font-semibold text-ink mb-1.5">Message d'accueil <span class="text-gray-400 font-normal">(HTML autorisé)</span></label>
        <textarea name="home_assistant_greeting" rows="2" class="form-textarea">{{ content.home_assistant_greeting }}</textarea>
      </div>
    </div>

    <button type="submit" class="btn-primary">Enregistrer la rangée d'informations</button>
  </form>
</div>

<!-- =====================  SUGGESTIONS ASSISTANT  ===================== -->
<div class="card overflow-hidden max-w-2xl">
  <div class="px-5 py-4 border-b border-gray-50 flex items-center justify-between gap-3">
    <div>
      <h2 class="font-bold text-ink">Suggestions de l'assistant</h2>
      <p class="text-sm text-gray-500 mt-0.5">Bulles cliquables proposées sous le message d'accueil.</p>
    </div>
    <a href="{{ base_path }}/admin/page-principale/suggestions/creer" class="btn-primary shrink-0">Ajouter une suggestion</a>
  </div>
  {% if chips is empty %}
    <div class="text-center py-16 px-6">
      <p class="text-gray-500 font-medium mb-1">Aucune suggestion pour le moment.</p>
      <a href="{{ base_path }}/admin/page-principale/suggestions/creer" class="text-brand-500 text-sm font-semibold hover:underline">Ajouter votre première suggestion</a>
    </div>
  {% else %}
    <ul class="divide-y divide-gray-50">
      {% for chip in chips %}
        <li class="flex items-center justify-between gap-3 px-5 py-3">
          <div class="flex items-center gap-3">
            <p class="font-semibold text-ink text-sm">{{ chip.label }}</p>
            {% if chip.status != 'active' %}
              <span class="text-xs font-semibold px-2 py-0.5 rounded-full bg-gray-100 text-gray-500">Inactive</span>
            {% endif %}
          </div>
          <div class="inline-flex items-center gap-3 shrink-0">
            <a href="{{ base_path }}/admin/page-principale/suggestions/{{ chip.id }}/modifier" class="text-xs font-bold text-gray-500 hover:text-brand-500">Modifier</a>
            <form method="POST" action="{{ base_path }}/admin/page-principale/suggestions/{{ chip.id }}/statut" class="inline">
              {{ csrf_field() }}
              <button type="submit" class="text-xs font-bold text-gray-500 hover:text-brand-500">
                {{ chip.status == 'active' ? 'Désactiver' : 'Activer' }}
              </button>
            </form>
            <form method="POST" action="{{ base_path }}/admin/page-principale/suggestions/{{ chip.id }}/supprimer" class="inline"
                  onsubmit="return confirm('Supprimer définitivement cette suggestion ?');">
              {{ csrf_field() }}
              <button type="submit" class="text-xs font-bold text-brand-500 hover:text-brand-600">Supprimer</button>
            </form>
          </div>
        </li>
      {% endfor %}
    </ul>
  {% endif %}
</div>
