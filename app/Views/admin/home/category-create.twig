{% set pageTitle = 'Ajouter une catégorie' %}
{% set pageSubtitle = "Cette tuile apparaîtra sur la page d'accueil, sous le hero." %}
{% set pageActions = [] %}
{% include 'partials/admin-page-header.twig' %}

<div class="max-w-2xl">
  <a href="{{ base_path }}/admin/page-principale" class="inline-flex items-center gap-1.5 text-sm font-semibold text-gray-500 hover:text-brand-500 mb-4">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
    Retour à la page principale
  </a>

  <div class="card card-md sm:p-8">
    <form method="POST" action="{{ base_path }}/admin/page-principale/categories" class="space-y-5">
      {{ csrf_field() }}

      <div>
        <label class="block text-sm font-semibold text-ink mb-1.5">Nom de la catégorie</label>
        <input type="text" name="name" required value="{{ old.name|default('') }}" placeholder="Ex : NOS SERVICES"
               class="form-input {{ errors.name is defined ? 'border-brand-400' : '' }}">
        {% if errors.name is defined %}<p class="text-brand-500 text-xs mt-1">{{ errors.name }}</p>{% endif %}
      </div>

      <div>
        <label class="block text-sm font-semibold text-ink mb-1.5">Description</label>
        <input type="text" name="description" value="{{ old.description|default('') }}" placeholder="Ex : Paiement de proximité, relais colis & plus"
               class="form-input">
      </div>

      <div>
        <label class="block text-sm font-semibold text-ink mb-1.5">Lien</label>
        <input type="text" name="link" required value="{{ old.link|default('') }}" placeholder="Ex : /nos-services"
               class="form-input {{ errors.link is defined ? 'border-brand-400' : '' }}">
        {% if errors.link is defined %}<p class="text-brand-500 text-xs mt-1">{{ errors.link }}</p>{% endif %}
        <p class="text-xs text-gray-400 mt-1">Chemin d'une page du site (ex : /nos-services) ou URL complète.</p>
      </div>

      <div>
        <label class="block text-sm font-semibold text-ink mb-1.5">Icône</label>
        <select name="icon" required class="form-select {{ errors.icon is defined ? 'border-brand-400' : '' }}">
          <option value="">Choisir une icône</option>
          {% for svg, label in iconChoices %}
            <option value="{{ svg }}" {{ old.icon|default('') == svg ? 'selected' : '' }}>{{ label }}</option>
          {% endfor %}
        </select>
        {% if errors.icon is defined %}<p class="text-brand-500 text-xs mt-1">{{ errors.icon }}</p>{% endif %}
      </div>

      <label class="flex items-center gap-2.5 text-sm text-gray-600 bg-gray-50 rounded-2xl px-4 py-3">
        <input type="checkbox" name="publish" value="1" checked class="rounded border-gray-300 text-brand-500 focus:ring-brand-500/30">
        Publier immédiatement sur la page d'accueil (sinon la catégorie est enregistrée inactive)
      </label>

      <button type="submit" class="btn-primary w-full">
        Ajouter la catégorie
      </button>
    </form>
  </div>
</div>
