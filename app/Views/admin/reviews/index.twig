{% set pageTitle = 'Avis clients' %}
{% set pageSubtitle = "Suivez vos avis Google en direct pour améliorer votre réputation en ligne." %}
{% set pageActions = [] %}
{% include 'partials/admin-page-header.twig' %}



<div class="grid lg:grid-cols-2 gap-6">

  <!-- Résumé -->
  <div class="card card-md text-center">
    <p class="font-extrabold text-5xl text-ink mb-1">{{ average|number_format(1) }}</p>
    <div class="flex items-center justify-center gap-1 text-amber-400 mb-2">
      {% for i in 0..4 %}
        <svg class="w-5 h-5" fill="{{ i < average|round ? 'currentColor' : 'none' }}" stroke="currentColor" stroke-width="1.5" viewBox="0 0 20 20"><path d="M10 15l-5.5 3 2-6.5L1 7h6.5L10 1l2.5 6H19l-5.5 4.5 2 6.5z"/></svg>
      {% endfor %}
    </div>
    <p class="text-sm text-gray-400">Basé sur {{ totalReviews }} avis Google</p>
    {% if not googleConfigured %}
      <p class="text-xs text-amber-500 mt-3">Synchronisation automatique non configurée (GOOGLE_PLACE_ID / clé API manquants dans .env) — valeurs par défaut affichées.</p>
    {% endif %}
  </div>

  <!-- Lien Google -->
  <div class="card card-md bg-ink text-white flex flex-col justify-between">
    <div>
      <h2 class="font-bold mb-1">Votre fiche Google</h2>
      <p class="text-gray-300 text-sm">Partagez ce lien à vos clients pour qu'ils laissent un avis directement sur Google.</p>
    </div>
    <a href="{{ googleMapsUrl }}" target="_blank" rel="noopener" class="mt-4 inline-flex items-center justify-center gap-2 bg-white text-ink font-bold text-sm px-5 py-3 rounded-lg hover:bg-gray-100 transition-colors">
      Voir la fiche Google
    </a>
  </div>
</div>

{% if googleConfigured %}
<!-- Derniers avis Google (via API) -->
<div class="bg-white border border-gray-100 rounded-2xl overflow-hidden mt-6">
  <div class="px-5 py-4 border-b border-gray-50">
    <h2 class="font-bold text-ink">Derniers avis Google</h2>
    <p class="text-xs text-gray-400 mt-0.5">Récupérés en direct depuis votre fiche Google (l'API n'en fournit que 5 maximum, quel que soit le nombre total d'avis).</p>
  </div>
  {% if googleReviews is empty %}
    <div class="text-center py-16 px-6">
      <p class="text-gray-500 font-medium">Aucun avis Google renvoyé par l'API pour le moment.</p>
    </div>
  {% else %}
    <div class="divide-y divide-gray-50">
      {% for r in googleReviews %}
        <div class="px-5 py-4">
          <div class="flex items-start gap-3 min-w-0">
            <span class="w-9 h-9 rounded-full bg-brand-50 text-brand-500 flex items-center justify-center text-xs font-bold shrink-0">
              {{ r.author_name|slice(0, 1) }}
            </span>
            <div class="min-w-0 flex-1">
              <div class="flex items-center gap-2 flex-wrap">
                <p class="font-semibold text-ink text-sm">{{ r.author_name }}</p>
                <div class="flex text-amber-400">
                  {% for i in 0..4 %}
                    <svg class="w-3 h-3" fill="{{ i < r.rating ? 'currentColor' : 'none' }}" stroke="currentColor" stroke-width="1.5" viewBox="0 0 20 20"><path d="M10 15l-5.5 3 2-6.5L1 7h6.5L10 1l2.5 6H19l-5.5 4.5 2 6.5z"/></svg>
                  {% endfor %}
                </div>
                {% if r.source_url %}
                  <a href="{{ r.source_url }}" target="_blank" rel="noopener" class="text-xs text-gray-400 hover:text-brand-500">Voir sur Google Maps</a>
                {% endif %}
              </div>
              {% if r.comment %}<p class="text-sm text-gray-500 mt-1">{{ r.comment }}</p>{% endif %}
              {% if r.published_at %}<p class="text-xs text-gray-400 mt-1">{{ r.published_at|date('d/m/Y') }}</p>{% endif %}
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  {% endif %}
</div>
{% endif %}
