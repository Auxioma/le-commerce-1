{% set pageTitle = 'Offres' %}
{% set pageSubtitle = 'Gérez vos offres, suivez les performances et activez rapidement des promotions pour vos clients.' %}
{% set pageActions = [
    {href: base_path ~ '/admin/offres/scanner', label: 'Scanner une offre', class: 'btn-secondary'},
    {href: base_path ~ '/admin/offres/creer', label: 'Créer une offre', class: 'btn-primary'},
] %}
{% include 'partials/admin-page-header.twig' %}

<!-- KPIs -->
<div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-6">
  <div class="card card-md">
    <p class="text-sm font-semibold text-gray-500 mb-2">Offres actives</p>
    <p class="font-extrabold text-3xl text-ink">{{ offersActive }}</p>
    <p class="text-xs font-semibold text-emerald-500 mt-1">+{{ offersDelta }} ce mois-ci</p>
  </div>
  <div class="card card-md">
    <p class="text-sm font-semibold text-gray-500 mb-2">Utilisations ce mois</p>
    <p class="font-extrabold text-3xl text-ink">{{ usagesThisMonth }}</p>
  </div>
  <div class="card card-md">
    <p class="text-sm font-semibold text-gray-500 mb-2">Clients touchés</p>
    <p class="font-extrabold text-3xl text-ink">{{ clientsTouched }}</p>
  </div>
  <div class="card card-md">
    <p class="text-sm font-semibold text-gray-500 mb-2">Économies offertes</p>
    <p class="font-extrabold text-3xl text-ink">{{ savings|number_format(2, ',', ' ') }} €</p>
  </div>
</div>

<div class="grid lg:grid-cols-3 gap-6">

  <!-- Liste des offres -->
  <div class="lg:col-span-2 card overflow-hidden">
    <div class="flex items-center gap-1 px-5 pt-4 border-b border-gray-50 overflow-x-auto">
      {% set tabs = {'active': 'Mes offres actives', 'brouillons': 'Brouillons', 'expirees': 'Offres expirées', 'toutes': 'Toutes les offres'} %}
      {% for key, label in tabs %}
        <a href="{{ base_path }}/admin/offres?statut={{ key }}"
           class="px-4 py-3 text-sm font-semibold border-b-2 -mb-px whitespace-nowrap transition-colors
                  {{ activeTab == key ? 'border-brand-500 text-brand-500' : 'border-transparent text-gray-400 hover:text-ink' }}">
          {{ label }}
        </a>
      {% endfor %}
    </div>

    {% if offers is empty %}
      <div class="text-center py-16 px-6">
        <p class="text-gray-500 font-medium mb-1">Aucune offre dans cette catégorie.</p>
        <a href="{{ base_path }}/admin/offres/creer" class="text-brand-500 text-sm font-semibold hover:underline">Créer votre première offre</a>
      </div>
    {% else %}
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="bg-gray-50">
            <tr class="text-left text-gray-500 text-xs uppercase tracking-wide">
              <th class="px-5 py-3 font-semibold">Offre</th>
              <th class="px-5 py-3 font-semibold">Type</th>
              <th class="px-5 py-3 font-semibold">Cible</th>
              <th class="px-5 py-3 font-semibold">Utilisations</th>
              <th class="px-5 py-3 font-semibold">Validité</th>
              <th class="px-5 py-3 font-semibold">Statut</th>
              <th class="px-5 py-3 font-semibold text-right">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-50">
            {% for offer in offers %}
              {% set isExpired = (offer.valid_until|date('U')) < ('today'|date('U')) %}
              <tr class="hover:bg-gray-50/50">
                <td class="px-5 py-3.5">
                  <p class="font-semibold text-ink">{{ offer.title }}</p>
                  {% if offer.description %}
                    <p class="text-xs text-gray-400 max-w-[220px] truncate">{{ offer.description }}</p>
                  {% endif %}
                </td>
                <td class="px-5 py-3.5 text-gray-600">{{ typeLabels[offer.type]|default(offer.type) }}</td>
                <td class="px-5 py-3.5 text-gray-600">{{ segmentLabels[offer.target_segment]|default(offer.target_segment) }}</td>
                <td class="px-5 py-3.5 font-semibold text-ink">{{ offer.usage_count }}</td>
                <td class="px-5 py-3.5 text-gray-500">{{ offer.valid_until|date('d/m/Y') }}</td>
                <td class="px-5 py-3.5">
                  {% if isExpired %}
                    <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-gray-100 text-gray-500">Expirée</span>
                  {% elseif offer.status == 'active' %}
                    <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-600">Active</span>
                  {% else %}
                    <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-amber-50 text-amber-600">Brouillon</span>
                  {% endif %}
                </td>
                <td class="px-5 py-3.5 text-right whitespace-nowrap">
                  <div class="flex items-center justify-end gap-3">
                    {% if not isExpired %}
                      <form method="POST" action="{{ base_path }}/admin/offres/{{ offer.id }}/statut" class="inline">
                        {{ csrf_field() }}
                        <button type="submit" class="text-xs font-bold text-gray-500 hover:text-brand-500">
                          {{ offer.status == 'active' ? 'Passer en brouillon' : 'Activer' }}
                        </button>
                      </form>
                    {% endif %}
                    <a href="{{ base_path }}/admin/offres/{{ offer.id }}/modifier" class="text-xs font-bold text-gray-500 hover:text-brand-500">Modifier</a>
                    <form method="POST" action="{{ base_path }}/admin/offres/{{ offer.id }}/supprimer" class="inline"
                          onsubmit="return confirm('Supprimer définitivement l\'offre « {{ offer.title|e('js') }} » ?');">
                      {{ csrf_field() }}
                      <button type="submit" class="text-xs font-bold text-gray-300 hover:text-brand-500">Suppr.</button>
                    </form>
                  </div>
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    {% endif %}
  </div>

  <!-- Panneaux d'action -->
  <div class="flex flex-col gap-6">

    <!-- Générer un code -->
    <div class="card card-md">
      <h2 class="font-bold text-ink mb-1">Générer un code / QR pour un client</h2>
      <p class="text-xs text-gray-400 mb-4">Créez un code unique à remettre en main propre.</p>
      <form method="POST" action="{{ base_path }}/admin/offres/generer" class="space-y-3">
        {{ csrf_field() }}
        <select name="user_id" required class="form-select">
          <option value="">Sélectionner un client</option>
          {% for c in clients %}
            <option value="{{ c.id }}">{{ c.first_name }} {{ c.last_name }} — {{ c.phone_whatsapp }}</option>
          {% endfor %}
        </select>
        <select name="offer_id" required class="form-select">
          <option value="">Sélectionner une offre</option>
          {% for o in activeOffers %}
            <option value="{{ o.id }}">{{ o.title }}</option>
          {% endfor %}
        </select>
        <button type="submit" class="w-full bg-ink hover:bg-black text-white font-bold text-sm px-5 py-3 rounded-lg transition-colors">
          Générer un code
        </button>
      </form>
    </div>

    <!-- Envoyer une offre -->
    <div class="card card-md">
      <h2 class="font-bold text-ink mb-1">Envoyer une offre à un client</h2>
      <p class="text-xs text-gray-400 mb-4">Envoyez directement l'offre et son code par WhatsApp.</p>
      <form method="POST" action="{{ base_path }}/admin/offres/envoyer" class="space-y-3">
        {{ csrf_field() }}
        <select name="user_id" required class="form-select">
          <option value="">Sélectionner un client</option>
          {% for c in clients %}
            <option value="{{ c.id }}">{{ c.first_name }} {{ c.last_name }}</option>
          {% endfor %}
        </select>
        <select name="offer_id" required class="form-select">
          <option value="">Sélectionner une offre</option>
          {% for o in activeOffers %}
            <option value="{{ o.id }}">{{ o.title }}</option>
          {% endfor %}
        </select>
        <button type="submit" class="w-full flex items-center justify-center gap-2 bg-emerald-500 hover:bg-emerald-600 text-white font-bold text-sm px-5 py-3 rounded-lg transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.4A10 10 0 1 0 12 2z"/></svg>
          Envoyer sur WhatsApp
        </button>
      </form>
    </div>
  </div>
</div>

<!-- Diffuser une offre par SMS / e-mail -->
<div class="card card-md sm:p-8 mt-6">
  <h2 class="font-bold text-ink mb-1">Diffuser une offre par SMS ou e-mail</h2>
  <p class="text-xs text-gray-400 mb-5">Chaque client reçoit son propre code à présenter en caisse (le même s'il en a déjà un valide pour cette offre).</p>

  {% if activeOffers is empty %}
    <p class="text-sm text-gray-500">Aucune offre active à diffuser. <a href="{{ base_path }}/admin/offres/creer" class="text-brand-500 font-semibold hover:underline">Créer une offre</a></p>
  {% else %}
    <form method="POST" action="{{ base_path }}/admin/offres/diffuser" class="space-y-5">
      {{ csrf_field() }}

      <div>
        <label class="block text-sm font-semibold text-ink mb-1.5">Offre à envoyer</label>
        <select name="offer_id" required class="form-select max-w-md">
          <option value="">Sélectionner une offre</option>
          {% for o in activeOffers %}
            <option value="{{ o.id }}">{{ o.title }}</option>
          {% endfor %}
        </select>
      </div>

      <div class="space-y-5" data-announce data-announce-empty="Cochez au moins un mode d'envoi : SMS, e-mail ou les deux.">
        <div>
          <p class="text-sm font-semibold text-ink mb-2">Mode d'envoi <span class="text-gray-400 font-normal">(l'un, l'autre ou les deux)</span></p>
          <div class="grid sm:grid-cols-2 gap-3">
            <label class="flex items-start gap-3 border border-gray-200 rounded-xl px-4 py-3 cursor-pointer hover:border-brand-500 transition-colors">
              <input type="checkbox" name="channels[]" value="sms" data-announce-channel class="mt-0.5 rounded border-gray-300 text-brand-500 focus:ring-brand-500/30">
              <span>
                <span class="block text-sm font-semibold text-ink">SMS</span>
                <span class="block text-xs text-gray-500">Message court avec l'offre, sa date de validité et le code du client. Hors créneau légal (lun.–sam. 8 h–20 h), il est programmé automatiquement.</span>
                {% if not smsConfigured %}
                  <span class="block text-xs text-brand-500 mt-1">⚠ AllMySms n'est pas configuré (ALLMYSMS_LOGIN / ALLMYSMS_API_KEY dans .env) : aucun SMS ne partira.</span>
                {% endif %}
              </span>
            </label>
            <label class="flex items-start gap-3 border border-gray-200 rounded-xl px-4 py-3 cursor-pointer hover:border-brand-500 transition-colors">
              <input type="checkbox" name="channels[]" value="email" data-announce-channel class="mt-0.5 rounded border-gray-300 text-brand-500 focus:ring-brand-500/30">
              <span>
                <span class="block text-sm font-semibold text-ink">E-mail</span>
                <span class="block text-xs text-gray-500">E-mail avec l'offre, le code à présenter en caisse et un lien vers « Mes offres ». Toujours avec un lien de désinscription.</span>
              </span>
            </label>
          </div>

          <!-- Recherche / sélection manuelle des destinataires e-mail (visible quand « E-mail » est coché) -->
          <div class="border border-gray-200 rounded-xl p-4 mt-3" data-email-picker hidden>
            <p class="text-sm font-semibold text-ink mb-1">Rechercher un client par e-mail <span class="text-gray-400 font-normal">(facultatif)</span></p>
            <p class="text-xs text-gray-500 mb-3">Sélectionnez une ou plusieurs adresses : l'e-mail ne partira qu'à elles (les segments ci-dessous ne s'appliqueront plus qu'au SMS). Laissez vide pour cibler par segments.</p>
            <div class="flex flex-wrap gap-1.5 mb-2" data-email-picker-chips></div>
            <div class="relative">
              <input type="search" autocomplete="off" placeholder="Rechercher un nom ou une adresse e-mail…" class="form-input" data-email-picker-search>
              <ul class="absolute z-10 left-0 right-0 mt-1 max-h-60 overflow-y-auto bg-white border border-gray-200 rounded-xl shadow-lg" data-email-picker-results hidden></ul>
            </div>
            <div data-email-picker-inputs></div>
          </div>
        </div>

        <div>
          <p class="text-sm font-semibold text-ink mb-2">Destinataires</p>
          <label class="flex items-center gap-2.5 text-sm font-semibold text-ink bg-gray-50 rounded-xl px-4 py-3 cursor-pointer mb-3">
            <input type="checkbox" name="segments[]" value="tous" data-announce-all class="rounded border-gray-300 text-brand-500 focus:ring-brand-500/30">
            Tous les clients actifs <span class="text-gray-400 font-normal">({{ audience|length }})</span>
          </label>
          <p class="text-xs text-gray-500 mb-2">… ou seulement certains segments (un client présent dans plusieurs segments cochés ne reçoit l'offre qu'une fois) :</p>
          <div class="grid sm:grid-cols-2 gap-4">
            {% for group, title in {'lifecycle': 'Cycle de vie', 'profiles': 'Profils'} %}
              <div>
                <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1.5">{{ title }}</p>
                <div class="space-y-1">
                  {% for key, def in segmentDefs[group] %}
                    <label class="flex items-center gap-2.5 rounded-lg px-2 py-1.5 cursor-pointer hover:bg-gray-50" title="{{ def.rule }}">
                      <input type="checkbox" name="segments[]" value="{{ key }}" data-announce-segment class="rounded border-gray-300 text-brand-500 focus:ring-brand-500/30">
                      <span class="px-2 py-0.5 rounded-full font-semibold {{ def.color }}" style="font-size:11px;">{{ def.label }}</span>
                      <span class="text-xs {{ segmentCounts[key] > 0 ? 'text-gray-500' : 'text-gray-300' }}">{{ segmentCounts[key] }}</span>
                    </label>
                  {% endfor %}
                </div>
              </div>
            {% endfor %}
          </div>
          <p class="text-xs text-gray-400 mt-2">Survolez un segment pour voir sa règle. Les segments sont calculés automatiquement (voir Mes clients › Clients inscrits).</p>
        </div>

        <div class="rounded-xl bg-brand-50 px-4 py-3 text-sm text-ink">
          <span data-announce-summary>—</span>
        </div>
        <script type="application/json" data-announce-audience>{{ audience|json_encode|raw }}</script>
      </div>

      <button type="submit" class="btn-primary w-full sm:w-auto">
        Envoyer l'offre
      </button>
    </form>
  {% endif %}
</div>
