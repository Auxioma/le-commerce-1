{% set pageTitle = 'Modifier un service' %}
{% set pageSubtitle = "Ajustez le nom, la description, l'icône ou le statut de publication de ce service." %}
{% set pageActions = [] %}
{% include 'partials/admin-page-header.twig' %}

{% set name = old.name|default(service.name) %}
{% set description = old.description|default(service.description|default('')) %}
{% set icon = old.icon|default(service.icon) %}
{% set publish = old.publish is defined ? old.publish : (service.status == 'active') %}

<div class="max-w-2xl">
  <a href="{{ base_path }}/admin/services" class="inline-flex items-center gap-1.5 text-sm font-semibold text-gray-500 hover:text-brand-500 mb-4">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
    Retour aux services
  </a>

  <div class="card card-md sm:p-8">
    <form method="POST" action="{{ base_path }}/admin/services/{{ service.id }}" class="space-y-5">
      {{ csrf_field() }}

      <div>
        <label class="block text-sm font-semibold text-ink mb-1.5">Nom du service</label>
        <input type="text" name="name" required value="{{ name }}"
               class="form-input {{ errors.name is defined ? 'border-brand-400' : '' }}">
        {% if errors.name is defined %}<p class="text-brand-500 text-xs mt-1">{{ errors.name }}</p>{% endif %}
      </div>

      <div>
        <label class="block text-sm font-semibold text-ink mb-1.5">Description</label>
        <textarea name="description" rows="2" class="form-textarea">{{ description }}</textarea>
      </div>

      <div>
        <label class="block text-sm font-semibold text-ink mb-1.5">Icône</label>
        <select name="icon" required class="form-select {{ errors.icon is defined ? 'border-brand-400' : '' }}">
          <option value="">Choisir une icône</option>
          {% for path, label in iconChoices %}
            <option value="{{ path }}" {{ icon == path ? 'selected' : '' }}>{{ label }}</option>
          {% endfor %}
        </select>
        {% if errors.icon is defined %}<p class="text-brand-500 text-xs mt-1">{{ errors.icon }}</p>{% endif %}
      </div>

      <label class="flex items-center gap-2.5 text-sm text-gray-600 bg-gray-50 rounded-2xl px-4 py-3">
        <input type="checkbox" name="publish" value="1" {{ publish ? 'checked' : '' }} class="rounded border-gray-300 text-brand-500 focus:ring-brand-500/30">
        Publié sur /nos-services
      </label>

      <button type="submit" class="btn-primary w-full">
        Enregistrer les modifications
      </button>
    </form>
  </div>
</div>
