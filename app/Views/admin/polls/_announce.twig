{#
 Annonce d'un nouveau sondage aux clients (SMS / e-mail, par segments ou
 e-mails choisis). Attend : announce {segmentDefs, segmentCounts, audience, smsConfigured}, old, errors
#}
{% set oldChannels = old.channels|default([]) %}
{% set oldSegments = old.segments|default([]) %}
<fieldset class="border border-gray-200 rounded-2xl p-5 space-y-5" data-announce
          data-announce-empty="Aucun mode de diffusion coché : le sondage sera publié sans annonce.">
  <legend class="px-2 font-bold text-ink">Annoncer le sondage à vos clients</legend>
  <p class="text-sm text-amber-700 bg-amber-50 rounded-xl px-4 py-2.5" data-announce-draft-note hidden>
    Le sondage sera enregistré comme programmé : aucune annonce ne sera envoyée.
  </p>

  <div data-announce-options>
    <p class="text-sm font-semibold text-ink mb-2">Mode de diffusion <span class="text-gray-400 font-normal">(l'un, l'autre, les deux ou aucun)</span></p>
    <div class="grid sm:grid-cols-2 gap-3">
      <label class="flex items-start gap-3 border border-gray-200 rounded-xl px-4 py-3 cursor-pointer hover:border-brand-500 transition-colors">
        <input type="checkbox" name="channels[]" value="sms" {{ 'sms' in oldChannels ? 'checked' : '' }} data-announce-channel class="mt-0.5 rounded border-gray-300 text-brand-500 focus:ring-brand-500/30">
        <span>
          <span class="block text-sm font-semibold text-ink">SMS</span>
          <span class="block text-xs text-gray-500">Message court avec la question et le lien pour voter. Hors créneau légal (lun.–sam. 8 h–20 h), il est programmé automatiquement.</span>
          {% if not announce.smsConfigured %}
            <span class="block text-xs text-brand-500 mt-1">⚠ AllMySms n'est pas configuré (ALLMYSMS_LOGIN / ALLMYSMS_API_KEY dans .env) : aucun SMS ne partira.</span>
          {% endif %}
        </span>
      </label>
      <label class="flex items-start gap-3 border border-gray-200 rounded-xl px-4 py-3 cursor-pointer hover:border-brand-500 transition-colors">
        <input type="checkbox" name="channels[]" value="email" {{ 'email' in oldChannels ? 'checked' : '' }} data-announce-channel class="mt-0.5 rounded border-gray-300 text-brand-500 focus:ring-brand-500/30">
        <span>
          <span class="block text-sm font-semibold text-ink">E-mail</span>
          <span class="block text-xs text-gray-500">E-mail avec la question, la date de fin, la récompense et un bouton « Je donne mon avis ». Toujours avec un lien de désinscription.</span>
        </span>
      </label>
    </div>

    <!-- Recherche / sélection manuelle des destinataires e-mail (visible quand « E-mail » est coché) -->
    <div class="border border-gray-200 rounded-xl p-4 mt-3" data-email-picker hidden>
      <p class="text-sm font-semibold text-ink mb-1">Rechercher un client par e-mail <span class="text-gray-400 font-normal">(facultatif)</span></p>
      <p class="text-xs text-gray-500 mb-3">Recherchez puis sélectionnez une ou plusieurs adresses : l'e-mail ne partira qu'à elles (les segments ci-dessous ne s'appliqueront plus qu'au SMS). Laissez vide pour cibler par segments.</p>
      <div class="flex flex-wrap gap-1.5 mb-2" data-email-picker-chips></div>
      <div class="relative">
        <input type="search" autocomplete="off" placeholder="Rechercher un nom ou une adresse e-mail…" class="form-input" data-email-picker-search>
        <ul class="absolute z-10 left-0 right-0 mt-1 max-h-60 overflow-y-auto bg-white border border-gray-200 rounded-xl shadow-lg" data-email-picker-results hidden></ul>
      </div>
      <div data-email-picker-inputs>
        {% for id in old.emailRecipients|default([]) %}<input type="hidden" name="email_recipients[]" value="{{ id }}">{% endfor %}
      </div>
    </div>
  </div>

  <div data-announce-options>
    <p class="text-sm font-semibold text-ink mb-2">Destinataires</p>
    <label class="flex items-center gap-2.5 text-sm font-semibold text-ink bg-gray-50 rounded-xl px-4 py-3 cursor-pointer mb-3">
      <input type="checkbox" name="segments[]" value="tous" {{ 'tous' in oldSegments ? 'checked' : '' }} data-announce-all class="rounded border-gray-300 text-brand-500 focus:ring-brand-500/30">
      Tous les clients actifs <span class="text-gray-400 font-normal">({{ announce.audience|length }})</span>
    </label>
    <p class="text-xs text-gray-500 mb-2">… ou seulement certains segments (un client présent dans plusieurs segments cochés ne reçoit l'annonce qu'une fois) :</p>
    <div class="grid sm:grid-cols-2 gap-4">
      {% for group, title in {'lifecycle': 'Cycle de vie', 'profiles': 'Profils'} %}
        <div>
          <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1.5">{{ title }}</p>
          <div class="space-y-1">
            {% for key, def in announce.segmentDefs[group] %}
              <label class="flex items-center gap-2.5 rounded-lg px-2 py-1.5 cursor-pointer hover:bg-gray-50" title="{{ def.rule }}">
                <input type="checkbox" name="segments[]" value="{{ key }}" {{ key in oldSegments ? 'checked' : '' }} data-announce-segment class="rounded border-gray-300 text-brand-500 focus:ring-brand-500/30">
                <span class="px-2 py-0.5 rounded-full font-semibold {{ def.color }}" style="font-size:11px;">{{ def.label }}</span>
                <span class="text-xs {{ announce.segmentCounts[key] > 0 ? 'text-gray-500' : 'text-gray-300' }}">{{ announce.segmentCounts[key] }}</span>
              </label>
            {% endfor %}
          </div>
        </div>
      {% endfor %}
    </div>
    {% if errors.segments is defined %}<p class="text-brand-500 text-xs mt-2">{{ errors.segments }}</p>{% endif %}
    <p class="text-xs text-gray-400 mt-2">Survolez un segment pour voir sa règle. Les segments sont calculés automatiquement (voir Mes clients › Clients inscrits).</p>
  </div>

  <div class="rounded-xl bg-brand-50 px-4 py-3 text-sm text-ink" data-announce-options>
    <span data-announce-summary>—</span>
  </div>
  <script type="application/json" data-announce-audience>{{ announce.audience|json_encode|raw }}</script>
</fieldset>
