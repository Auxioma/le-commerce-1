{#
 Annonce d'un nouveau sondage aux clients : mode de diffusion (SMS et/ou
 e-mail) puis choix des destinataires, client par client, dans un tableau
 filtrable. Attend : announce {clients, groups, smsConfigured}, old, errors
#}
{% set oldChannels = old.channels|default([]) %}
<section class="card card-md space-y-6" data-poll-announce
         data-announce-empty="Aucun mode de diffusion choisi : le sondage sera publié sans annonce.">
  <div class="flex items-center gap-3">
    <span class="w-7 h-7 rounded-full bg-brand-50 text-brand-500 text-xs font-bold flex items-center justify-center shrink-0">3</span>
    <div>
      <h2 class="font-bold text-ink">Annoncer le sondage</h2>
      <p class="text-xs text-gray-500">Choisissez comment prévenir vos clients, puis à qui envoyer l'annonce.</p>
    </div>
  </div>

  <p class="text-sm text-amber-700 bg-amber-50 rounded-xl px-4 py-3" data-announce-draft-note hidden>
    Le sondage sera enregistré comme programmé : aucune annonce ne sera envoyée.
  </p>

  <!-- Mode de diffusion -->
  <div class="grid sm:grid-cols-2 gap-3" data-announce-options>
    <label class="flex items-start gap-3 rounded-xl border border-gray-200 px-4 py-3.5 cursor-pointer transition-colors hover:border-gray-300 has-[:checked]:border-brand-500 has-[:checked]:bg-brand-50/50">
      <input type="checkbox" name="channels[]" value="sms" {{ 'sms' in oldChannels ? 'checked' : '' }} data-announce-channel class="mt-0.5 rounded border-gray-300 text-brand-500 focus:ring-brand-500/30">
      <span class="min-w-0">
        <span class="flex items-center gap-2 text-sm font-semibold text-ink">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 10h.01M12 10h.01M16 10h.01M21 12c0 4.418-4.03 8-9 8a9.86 9.86 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
          SMS
        </span>
        <span class="block text-xs text-gray-500 mt-0.5">Question et lien pour voter. Programmé automatiquement hors créneau légal (lun.–sam. 8 h–20 h).</span>
        {% if not announce.smsConfigured %}
          <span class="block text-xs text-brand-500 mt-1">AllMySms n'est pas configuré : aucun SMS ne partira.</span>
        {% endif %}
      </span>
    </label>
    <label class="flex items-start gap-3 rounded-xl border border-gray-200 px-4 py-3.5 cursor-pointer transition-colors hover:border-gray-300 has-[:checked]:border-brand-500 has-[:checked]:bg-brand-50/50">
      <input type="checkbox" name="channels[]" value="email" {{ 'email' in oldChannels ? 'checked' : '' }} data-announce-channel class="mt-0.5 rounded border-gray-300 text-brand-500 focus:ring-brand-500/30">
      <span class="min-w-0">
        <span class="flex items-center gap-2 text-sm font-semibold text-ink">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          E-mail
        </span>
        <span class="block text-xs text-gray-500 mt-0.5">Question, date de fin, récompense et bouton « Je donne mon avis », avec lien de désinscription.</span>
      </span>
    </label>
  </div>

  <!-- Destinataires -->
  <div data-announce-options>
    <div class="flex flex-wrap items-end justify-between gap-2 mb-3">
      <p class="text-sm font-semibold text-ink">Destinataires</p>
      <p class="text-xs text-gray-500" data-recipient-count>—</p>
    </div>

    <!-- Filtres -->
    <div class="flex flex-wrap items-center gap-2 mb-3">
      <div class="relative flex-1 min-w-[220px]">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-gray-400 absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path stroke-linecap="round" d="M21 21l-4.35-4.35"/></svg>
        <input type="search" data-filter="q" placeholder="Rechercher un nom, un e-mail, un téléphone…" class="form-input !rounded-xl !py-2.5 !pl-10">
      </div>
      <select data-filter="group" class="form-select !w-auto !rounded-xl !py-2.5">
        <option value="">Tous les groupes</option>
        {% for key, def in announce.groups %}<option value="{{ key }}">{{ def.label }}</option>{% endfor %}
      </select>
      <div class="flex items-center gap-2 border border-gray-200 rounded-xl px-3 py-1.5 text-sm text-gray-500">
        <span class="shrink-0">Inscrits du</span>
        <input type="date" data-filter="from" class="bg-transparent focus:outline-none text-ink text-sm">
        <span class="shrink-0">au</span>
        <input type="date" data-filter="to" class="bg-transparent focus:outline-none text-ink text-sm">
      </div>
      <button type="button" data-filter-reset class="text-sm font-semibold text-gray-500 hover:text-brand-500 px-2 py-2">Réinitialiser</button>
    </div>

    <!-- Tableau -->
    <div class="border border-gray-200 rounded-xl overflow-hidden">
      <div class="overflow-auto" style="max-height:28rem;">
        <table class="min-w-full text-sm">
          <thead class="bg-gray-50 sticky top-0 z-10 shadow-[inset_0_-1px_0_theme(colors.gray.200)]">
            <tr class="text-left text-xs font-semibold text-gray-500 uppercase tracking-wide">
              <th class="pl-4 pr-2 py-3 w-10">
                <input type="checkbox" data-recipient-all class="rounded border-gray-300 text-brand-500 focus:ring-brand-500/30" title="Cocher / décocher les clients affichés">
              </th>
              <th class="px-3 py-3 cursor-pointer select-none whitespace-nowrap hover:text-ink" data-sort="id">ID</th>
              <th class="px-3 py-3 cursor-pointer select-none whitespace-nowrap hover:text-ink" data-sort="first">Prénom</th>
              <th class="px-3 py-3 cursor-pointer select-none whitespace-nowrap hover:text-ink" data-sort="last">Nom</th>
              <th class="px-3 py-3 cursor-pointer select-none whitespace-nowrap hover:text-ink" data-sort="email">E-mail</th>
              <th class="px-3 py-3 cursor-pointer select-none whitespace-nowrap hover:text-ink" data-sort="phone">Téléphone</th>
              <th class="px-3 py-3 cursor-pointer select-none whitespace-nowrap hover:text-ink" data-sort="group">Groupe</th>
              <th class="px-3 py-3 cursor-pointer select-none whitespace-nowrap hover:text-ink text-right" data-sort="sales">Ventes</th>
              <th class="px-3 py-3 cursor-pointer select-none whitespace-nowrap hover:text-ink" data-sort="created">Inscription</th>
              <th class="px-3 py-3 pr-4 cursor-pointer select-none whitespace-nowrap hover:text-ink" data-sort="visit">Dernière visite</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100" data-recipient-rows></tbody>
        </table>
      </div>
      <div class="flex items-center justify-between gap-2 px-4 py-2.5 bg-gray-50 border-t border-gray-200 text-xs">
        <span class="text-gray-400">Cliquez sur une ligne pour la cocher.</span>
        <button type="button" data-recipient-clear class="font-semibold text-gray-500 hover:text-brand-500">Tout décocher</button>
      </div>
    </div>
    <div data-recipient-inputs>
      {% for id in old.recipients|default([]) %}<input type="hidden" name="recipients[]" value="{{ id }}">{% endfor %}
    </div>
    {% if errors.recipients is defined %}<p class="text-brand-500 text-xs mt-2">{{ errors.recipients }}</p>{% endif %}
  </div>

  <div class="flex items-start gap-3 rounded-xl bg-gray-50 px-4 py-3 text-sm text-ink" data-announce-options>
    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-brand-500 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z"/></svg>
    <span data-announce-summary>—</span>
  </div>
  <script type="application/json" data-recipient-data>{{ {clients: announce.clients, groups: announce.groups}|json_encode(constant('JSON_HEX_TAG'))|raw }}</script>
</section>
