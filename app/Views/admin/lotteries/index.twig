{% set pageTitle = 'Loterie' %}
{% set pageSubtitle = 'Créez des tirages au sort, suivez les participations et désignez un gagnant en un clic.' %}
{% set pageActions = [
    {href: base_path ~ '/admin/loterie/creer', label: 'Créer une loterie', class: 'btn-primary'},
] %}
{% include 'partials/admin-page-header.twig' %}

<!-- KPIs -->
<div class="grid sm:grid-cols-3 gap-5 mb-6">
  <div class="card card-md">
    <p class="text-sm font-semibold text-gray-500 mb-2">Loteries actives</p>
    <p class="font-extrabold text-3xl text-ink">{{ lotteriesActive }}</p>
  </div>
  <div class="card card-md">
    <p class="text-sm font-semibold text-gray-500 mb-2">Brouillons</p>
    <p class="font-extrabold text-3xl text-ink">{{ lotteriesDraft }}</p>
  </div>
  <div class="card card-md">
    <p class="text-sm font-semibold text-gray-500 mb-2">Terminées</p>
    <p class="font-extrabold text-3xl text-ink">{{ lotteriesDone }}</p>
  </div>
</div>

<!-- Statistiques SMS (AllMySms) -->
<div class="card card-md mb-6">
  <div class="flex items-center justify-between mb-4">
    <h2 class="font-bold text-ink text-xs uppercase tracking-wide">SMS d'annonce — AllMySms</h2>
  </div>

  {% if not smsConfigured %}
    <p class="text-sm text-gray-400 py-2">Configuration requise pour l'envoi automatique de SMS et l'affichage des statistiques.</p>
    <p class="text-xs text-gray-400">Renseignez <code class="text-gray-500">ALLMYSMS_LOGIN</code> et <code class="text-gray-500">ALLMYSMS_API_KEY</code> dans le fichier <code class="text-gray-500">.env</code> du serveur.</p>
  {% else %}
    <div class="grid sm:grid-cols-3 gap-4 mb-5">
      <div>
        <p class="text-xs text-gray-400 mb-1">Solde du compte</p>
        <p class="font-bold text-ink">{{ smsAccountInfo and smsAccountInfo.balance is defined ? smsAccountInfo.balance ~ ' €' : '—' }}</p>
      </div>
      <div>
        <p class="text-xs text-gray-400 mb-1">Crédits SMS restants</p>
        <p class="font-bold text-ink">{{ smsAccountInfo and smsAccountInfo.credits is defined ? smsAccountInfo.credits : '—' }}</p>
      </div>
      <div>
        <p class="text-xs text-gray-400 mb-1">SMS envoyés (loteries)</p>
        <p class="font-bold text-ink">{{ smsTotalSent }}</p>
      </div>
    </div>

    {% if smsCampaignStats is not empty %}
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="text-left text-gray-400 text-xs uppercase tracking-wide">
              <th class="py-2 pr-4 font-semibold">Loterie</th>
              <th class="py-2 pr-4 font-semibold">Envoyés</th>
              <th class="py-2 pr-4 font-semibold">Délivrés</th>
              <th class="py-2 pr-4 font-semibold">En attente</th>
              <th class="py-2 pr-4 font-semibold">Erreurs</th>
              <th class="py-2 pr-4 font-semibold">Clics sur le lien</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-50">
            {% for l in lotteries %}
              {% if smsCampaignStats[l.id] is defined %}
                {% set s = smsCampaignStats[l.id] %}
                <tr>
                  <td class="py-2 pr-4 font-semibold text-ink">{{ l.title }}</td>
                  <td class="py-2 pr-4">{{ s.nbSms|default(0) }}</td>
                  <td class="py-2 pr-4 text-emerald-600 font-semibold">{{ s.delivered|default(0) }}</td>
                  <td class="py-2 pr-4 text-amber-600">{{ s.pending|default(0) }}</td>
                  <td class="py-2 pr-4 text-brand-500">{{ (s.error|default(0)) + (s.invalid|default(0)) }}</td>
                  <td class="py-2 pr-4">{{ s.click|default(0) }}{% if s.uniqueClick is defined %} ({{ s.uniqueClick }} unique{{ s.uniqueClick > 1 ? 's' : '' }}){% endif %}</td>
                </tr>
              {% endif %}
            {% endfor %}
          </tbody>
        </table>
      </div>
    {% else %}
      <p class="text-sm text-gray-400 py-2">Aucune campagne SMS envoyée pour le moment — publiez une loterie pour déclencher l'annonce automatique.</p>
    {% endif %}
  {% endif %}
</div>

<div class="card overflow-hidden">
  <div class="flex items-center gap-1 px-5 pt-4 border-b border-gray-50 overflow-x-auto">
    {% set tabs = {'actives': 'Actives', 'brouillons': 'Brouillons', 'terminees': 'Terminées', 'toutes': 'Toutes'} %}
    {% for key, label in tabs %}
      <a href="{{ base_path }}/admin/loterie?statut={{ key }}"
         class="px-4 py-3 text-sm font-semibold border-b-2 -mb-px whitespace-nowrap transition-colors
                {{ activeTab == key ? 'border-brand-500 text-brand-500' : 'border-transparent text-gray-400 hover:text-ink' }}">
        {{ label }}
      </a>
    {% endfor %}
  </div>

  {% if lotteries is empty %}
    <div class="text-center py-16 px-6">
      <p class="text-gray-500 font-medium mb-1">Aucune loterie dans cette catégorie.</p>
      <a href="{{ base_path }}/admin/loterie/creer" class="text-brand-500 text-sm font-semibold hover:underline">Créer votre première loterie</a>
    </div>
  {% else %}
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="bg-gray-50">
          <tr class="text-left text-gray-500 text-xs uppercase tracking-wide">
            <th class="px-5 py-3 font-semibold">Loterie</th>
            <th class="px-5 py-3 font-semibold">Lot à gagner</th>
            <th class="px-5 py-3 font-semibold">Participants</th>
            <th class="px-5 py-3 font-semibold">Fin</th>
            <th class="px-5 py-3 font-semibold">Statut / Gagnant</th>
            <th class="px-5 py-3 font-semibold text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-50">
          {% for l in lotteries %}
            <tr class="hover:bg-gray-50/50">
              <td class="px-5 py-3.5">
                <p class="font-semibold text-ink">{{ l.title }}</p>
                {% if l.description %}
                  <p class="text-xs text-gray-400 max-w-[220px] truncate">{{ l.description }}</p>
                {% endif %}
              </td>
              <td class="px-5 py-3.5 text-gray-600">{{ l.prize }}</td>
              <td class="px-5 py-3.5 font-semibold text-ink">{{ l.entries_count }}</td>
              <td class="px-5 py-3.5 text-gray-500">{{ l.ends_at|date('d/m/Y') }}</td>
              <td class="px-5 py-3.5">
                {% if l.status == 'terminee' %}
                  <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-gray-100 text-gray-600">Terminée</span>
                  {% if l.winner_first_name %}
                    <p class="text-xs text-gray-500 mt-1">🏆 {{ l.winner_first_name }} {{ l.winner_last_name }}</p>
                  {% endif %}
                {% elseif l.status == 'active' %}
                  <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-600">Active</span>
                {% else %}
                  <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-amber-50 text-amber-600">Brouillon</span>
                {% endif %}
              </td>
              <td class="px-5 py-3.5 text-right">
                <div class="inline-flex items-center gap-2">
                  <a href="{{ base_path }}/admin/loterie/{{ l.id }}/qrcode" class="text-xs font-bold text-gray-500 hover:text-brand-500">QR code</a>
                  {% if l.status != 'terminee' %}
                    <form method="POST" action="{{ base_path }}/admin/loterie/{{ l.id }}/statut" class="inline">
                      {{ csrf_field() }}
                      <button type="submit" class="text-xs font-bold text-gray-500 hover:text-brand-500">
                        {{ l.status == 'active' ? 'Passer en brouillon' : 'Activer' }}
                      </button>
                    </form>
                    <form method="POST" action="{{ base_path }}/admin/loterie/{{ l.id }}/tirage" class="inline"
                          onsubmit="return confirm('Tirer un gagnant au sort parmi les {{ l.entries_count }} participants ? Cette action est définitive.');">
                      {{ csrf_field() }}
                      <button type="submit" class="text-xs font-bold text-white bg-ink hover:bg-black px-3 py-1.5 rounded-lg">
                        🎲 Tirer au sort
                      </button>
                    </form>
                  {% endif %}
                  <form method="POST" action="{{ base_path }}/admin/loterie/{{ l.id }}/supprimer" class="inline"
                        onsubmit="return confirm('Supprimer cette loterie ?');">
                    {{ csrf_field() }}
                    <button type="submit" class="text-xs font-semibold text-gray-300 hover:text-brand-500">Suppr.</button>
                  </form>
                </div>
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  {% endif %}
</div>
