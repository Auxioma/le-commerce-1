{% set pageTitle = 'Créer une loterie' %}
{% set pageSubtitle = 'Configurez un nouveau tirage au sort pour vos clients.' %}
{% set pageActions = [] %}
{% include 'partials/admin-page-header.twig' %}

<div class="max-w-2xl">
  <a href="{{ base_path }}/admin/loterie" class="inline-flex items-center gap-1.5 text-sm font-semibold text-gray-500 hover:text-brand-500 mb-4">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
    Retour à la loterie
  </a>

  <div class="card card-md sm:p-8">
    <form method="POST" action="{{ base_path }}/admin/loterie" class="space-y-5">
      {{ csrf_field() }}

      <div>
        <label class="block text-sm font-semibold text-ink mb-1.5">Titre de la loterie</label>
        <input type="text" name="title" required value="{{ old.title|default('') }}" placeholder="Ex : Tirage de rentrée"
               class="form-input {{ errors.title is defined ? 'border-brand-400' : '' }}">
        {% if errors.title is defined %}<p class="text-brand-500 text-xs mt-1">{{ errors.title }}</p>{% endif %}
      </div>

      <div>
        <label class="block text-sm font-semibold text-ink mb-1.5">Description</label>
        <textarea name="description" rows="2" placeholder="Ex : Participez pour tenter de remporter..."
                  class="form-textarea">{{ old.description|default('') }}</textarea>
      </div>

      <div class="grid sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-semibold text-ink mb-1.5">Lot à gagner</label>
          <input type="text" name="prize" required value="{{ old.prize|default('') }}" placeholder="Ex : Panier gourmand (valeur 40€)"
                 class="form-input {{ errors.prize is defined ? 'border-brand-400' : '' }}">
          {% if errors.prize is defined %}<p class="text-brand-500 text-xs mt-1">{{ errors.prize }}</p>{% endif %}
        </div>
        <div>
          <label class="block text-sm font-semibold text-ink mb-1.5">Date de fin des inscriptions</label>
          <input type="date" name="ends_at" required value="{{ old.endsAt|default('') }}" min="{{ "now"|date('Y-m-d') }}"
                 class="form-input {{ errors.ends_at is defined ? 'border-brand-400' : '' }}">
          {% if errors.ends_at is defined %}<p class="text-brand-500 text-xs mt-1">{{ errors.ends_at }}</p>{% endif %}
        </div>
      </div>

      <label class="flex items-center gap-2.5 text-sm text-gray-600 bg-gray-50 rounded-2xl px-4 py-3">
        <input type="checkbox" name="publish" value="1" {{ old.publish ? 'checked' : '' }} data-announce-publish class="rounded border-gray-300 text-brand-500 focus:ring-brand-500/30">
        Publier immédiatement (sinon la loterie est enregistrée en brouillon)
      </label>

      <!-- =====================  ANNONCE AUX CLIENTS  ===================== -->
      {% set oldChannels = old.channels|default([]) %}
      {% set oldSegments = old.segments|default([]) %}
      <fieldset class="border border-gray-200 rounded-2xl p-5 space-y-5" data-announce>
        <legend class="px-2 font-bold text-ink">Annoncer la loterie à vos clients</legend>
        <p class="text-sm text-amber-700 bg-amber-50 rounded-xl px-4 py-2.5" data-announce-draft-note hidden>
          La loterie sera enregistrée en brouillon : aucune annonce ne sera envoyée.
        </p>

        <div data-announce-options>
          <p class="text-sm font-semibold text-ink mb-2">Mode de diffusion <span class="text-gray-400 font-normal">(l'un, l'autre, les deux ou aucun)</span></p>
          <div class="grid sm:grid-cols-2 gap-3">
            <label class="flex items-start gap-3 border border-gray-200 rounded-xl px-4 py-3 cursor-pointer hover:border-brand-500 transition-colors">
              <input type="checkbox" name="channels[]" value="sms" {{ 'sms' in oldChannels ? 'checked' : '' }} data-announce-channel class="mt-0.5 rounded border-gray-300 text-brand-500 focus:ring-brand-500/30">
              <span>
                <span class="block text-sm font-semibold text-ink">SMS</span>
                <span class="block text-xs text-gray-500">Message court avec le lien de participation. Hors créneau légal (lun.–sam. 8 h–20 h), il est programmé automatiquement.</span>
                {% if not smsConfigured %}
                  <span class="block text-xs text-brand-500 mt-1">⚠ AllMySms n'est pas configuré (ALLMYSMS_LOGIN / ALLMYSMS_API_KEY dans .env) : aucun SMS ne partira.</span>
                {% endif %}
              </span>
            </label>
            <label class="flex items-start gap-3 border border-gray-200 rounded-xl px-4 py-3 cursor-pointer hover:border-brand-500 transition-colors">
              <input type="checkbox" name="channels[]" value="email" {{ 'email' in oldChannels ? 'checked' : '' }} data-announce-channel class="mt-0.5 rounded border-gray-300 text-brand-500 focus:ring-brand-500/30">
              <span>
                <span class="block text-sm font-semibold text-ink">E-mail</span>
                <span class="block text-xs text-gray-500">E-mail illustré avec le lot, la date de fin et un bouton « Je participe ». Toujours avec un lien de désinscription.</span>
              </span>
            </label>
          </div>

          <!-- Sélection manuelle des destinataires e-mail (visible quand « E-mail » est coché) -->
          <div class="border border-gray-200 rounded-xl p-4 mt-3" data-email-picker hidden>
            <p class="text-sm font-semibold text-ink mb-1">Destinataires de l'e-mail <span class="text-gray-400 font-normal">(facultatif)</span></p>
            <p class="text-xs text-gray-500 mb-3">Recherchez puis sélectionnez une ou plusieurs adresses : l'e-mail ne partira qu'à elles (les segments ci-dessous ne s'appliqueront plus qu'au SMS). Laissez vide pour cibler par segments.</p>
            <div class="flex flex-wrap gap-1.5 mb-2" data-email-picker-chips></div>
            <div class="relative">
              <input type="search" autocomplete="off" placeholder="Rechercher un nom ou une adresse e-mail…" class="form-input" data-email-picker-search>
              <ul class="absolute z-10 left-0 right-0 mt-1 max-h-60 overflow-y-auto bg-white border border-gray-200 rounded-xl shadow-lg" data-email-picker-results hidden></ul>
            </div>
            <div data-email-picker-inputs>
              {% for id in old.emailRecipients|default([]) %}<input type="hidden" name="email_recipients[]" value="{{ id }}">{% endfor %}
            </div>
          </div>
        </div>

        <div data-announce-options>
          <p class="text-sm font-semibold text-ink mb-2">Destinataires</p>
          <label class="flex items-center gap-2.5 text-sm font-semibold text-ink bg-gray-50 rounded-xl px-4 py-3 cursor-pointer mb-3">
            <input type="checkbox" name="segments[]" value="tous" {{ 'tous' in oldSegments ? 'checked' : '' }} data-announce-all class="rounded border-gray-300 text-brand-500 focus:ring-brand-500/30">
            Tous les clients actifs <span class="text-gray-400 font-normal">({{ audience|length }})</span>
          </label>
          <p class="text-xs text-gray-500 mb-2">… ou seulement certains segments (un client présent dans plusieurs segments cochés ne reçoit l'annonce qu'une fois) :</p>
          <div class="grid sm:grid-cols-2 gap-4">
            {% for group, title in {'lifecycle': 'Cycle de vie', 'profiles': 'Profils'} %}
              <div>
                <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1.5">{{ title }}</p>
                <div class="space-y-1">
                  {% for key, def in segmentDefs[group] %}
                    <label class="flex items-center gap-2.5 rounded-lg px-2 py-1.5 cursor-pointer hover:bg-gray-50" title="{{ def.rule }}">
                      <input type="checkbox" name="segments[]" value="{{ key }}" {{ key in oldSegments ? 'checked' : '' }} data-announce-segment class="rounded border-gray-300 text-brand-500 focus:ring-brand-500/30">
                      <span class="px-2 py-0.5 rounded-full font-semibold {{ def.color }}" style="font-size:11px;">{{ def.label }}</span>
                      <span class="text-xs {{ segmentCounts[key] > 0 ? 'text-gray-500' : 'text-gray-300' }}">{{ segmentCounts[key] }}</span>
                    </label>
                  {% endfor %}
                </div>
              </div>
            {% endfor %}
          </div>
          {% if errors.segments is defined %}<p class="text-brand-500 text-xs mt-2">{{ errors.segments }}</p>{% endif %}
          <p class="text-xs text-gray-400 mt-2">Survolez un segment pour voir sa règle. Les segments sont calculés automatiquement (voir Mes clients › Clients inscrits).</p>
        </div>

        <div class="rounded-xl bg-brand-50 px-4 py-3 text-sm text-ink" data-announce-options>
          <span data-announce-summary>—</span>
        </div>
        <script type="application/json" id="lottery-audience" data-announce-audience>{{ audience|json_encode|raw }}</script>
      </fieldset>

      <button type="submit" class="btn-primary w-full" data-announce-submit
              data-label-idle="Créer la loterie" data-label-send="Créer la loterie et envoyer l'annonce">
        Créer la loterie
      </button>
    </form>
  </div>
</div>
