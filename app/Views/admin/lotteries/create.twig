{% set pageTitle = 'Créer une loterie' %}
{% set pageSubtitle = 'Configurez un nouveau tirage au sort pour vos clients.' %}
{% set pageActions = [] %}
{% include 'partials/admin-page-header.twig' %}

<div class="max-w-6xl">
  <a href="{{ base_path }}/admin/loterie" class="inline-flex items-center gap-1.5 text-sm font-semibold text-gray-500 hover:text-brand-500 mb-4">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
    Retour à la loterie
  </a>

  <form method="POST" action="{{ base_path }}/admin/loterie" class="space-y-6">
    {{ csrf_field() }}

    <div class="grid lg:grid-cols-3 gap-6 items-start">
      <!-- 1. La loterie -->
      <section class="card card-md lg:col-span-2 space-y-5">
        <div class="flex items-center gap-3">
          <span class="w-7 h-7 rounded-full bg-brand-50 text-brand-500 text-xs font-bold flex items-center justify-center shrink-0">1</span>
          <h2 class="font-bold text-ink">La loterie</h2>
        </div>

        <div>
          <label class="block text-sm font-semibold text-ink mb-1.5">Titre de la loterie</label>
          <input type="text" name="title" required value="{{ old.title|default('') }}" placeholder="Ex : Tirage de rentrée"
                 class="form-input {{ errors.title is defined ? 'border-brand-400' : '' }}">
          {% if errors.title is defined %}<p class="text-brand-500 text-xs mt-1">{{ errors.title }}</p>{% endif %}
        </div>

        <div>
          <label class="block text-sm font-semibold text-ink mb-1.5">Description <span class="text-gray-400 font-normal">(facultatif)</span></label>
          <textarea name="description" rows="2" placeholder="Ex : Participez pour tenter de remporter..."
                    class="form-textarea">{{ old.description|default('') }}</textarea>
        </div>

        <div>
          <label class="block text-sm font-semibold text-ink mb-1.5">Lot à gagner</label>
          <input type="text" name="prize" required value="{{ old.prize|default('') }}" placeholder="Ex : Panier gourmand (valeur 40€)"
                 class="form-input {{ errors.prize is defined ? 'border-brand-400' : '' }}">
          {% if errors.prize is defined %}<p class="text-brand-500 text-xs mt-1">{{ errors.prize }}</p>{% endif %}
        </div>
      </section>

      <!-- 2. Date et publication -->
      <section class="card card-md space-y-5">
        <div class="flex items-center gap-3">
          <span class="w-7 h-7 rounded-full bg-brand-50 text-brand-500 text-xs font-bold flex items-center justify-center shrink-0">2</span>
          <h2 class="font-bold text-ink">Date et publication</h2>
        </div>

        <div>
          <label class="block text-sm font-semibold text-ink mb-1.5">Fin des inscriptions</label>
          <input type="date" name="ends_at" required value="{{ old.endsAt|default('') }}" min="{{ "now"|date('Y-m-d') }}"
                 class="form-input {{ errors.ends_at is defined ? 'border-brand-400' : '' }}">
          {% if errors.ends_at is defined %}<p class="text-brand-500 text-xs mt-1">{{ errors.ends_at }}</p>{% endif %}
        </div>

        <label class="flex items-center justify-between gap-4 border-t border-gray-100 pt-5 cursor-pointer">
          <span>
            <span class="block text-sm font-semibold text-ink">Publier immédiatement</span>
            <span class="block text-xs text-gray-500">Sinon, la loterie est enregistrée en brouillon.</span>
          </span>
          <span class="relative shrink-0">
            <input type="checkbox" name="publish" value="1" {{ old.publish ? 'checked' : '' }} data-announce-publish class="peer sr-only">
            <span class="block w-11 h-6 rounded-full bg-gray-200 transition-colors peer-checked:bg-brand-500 peer-focus-visible:ring-2 peer-focus-visible:ring-brand-500/30"></span>
            <span class="absolute top-0.5 left-0.5 w-5 h-5 rounded-full bg-white shadow transition-transform peer-checked:translate-x-5"></span>
          </span>
        </label>
      </section>
    </div>

    <!-- 3. Annonce aux clients -->
    {% include 'partials/admin-announce.twig' with {
        announceStep: 3,
        announceTitle: 'Annoncer la loterie',
        announceSubtitle: 'Choisissez comment prévenir vos clients, puis à qui envoyer l\'annonce.',
        announceSmsHint: 'Lien de participation. Programmé automatiquement hors créneau légal (lun.–sam. 8 h–20 h).',
        announceEmailHint: 'E-mail illustré avec le lot, la date de fin et un bouton « Je participe », avec lien de désinscription.',
        announceEmpty: 'Aucun mode de diffusion choisi : la loterie sera publiée sans annonce.',
        announceDraftNote: 'La loterie sera enregistrée en brouillon : aucune annonce ne sera envoyée.',
    } %}

    <div class="flex flex-col-reverse sm:flex-row sm:items-center sm:justify-end gap-3">
      <a href="{{ base_path }}/admin/loterie" class="text-center text-sm font-semibold text-gray-500 hover:text-ink px-5 py-3">Annuler</a>
      <button type="submit" class="btn-primary px-8" data-announce-submit
              data-label-idle="Créer la loterie" data-label-send="Créer la loterie et envoyer l'annonce">
        Créer la loterie
      </button>
    </div>
  </form>
</div>
