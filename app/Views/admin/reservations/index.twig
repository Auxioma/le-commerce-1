<!-- En-tête -->
<div class="flex items-start justify-between mb-6 gap-4 flex-wrap">
  <div>
    <h1 class="font-extrabold text-ink" style="font-size:22px; letter-spacing:-0.5px;">Réservations</h1>
    <p class="text-gray-500 mt-1" style="font-size:13px;">Demandes de réservation de table reçues via le site.</p>
  </div>
  <div class="flex items-center gap-3 shrink-0">
    <div class="flex items-center gap-3 bg-white border border-gray-200 rounded-xl px-4 py-3 shadow-sm">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path stroke-linecap="round" d="M12 7v5l3 3"/></svg>
      <div>
        <p class="text-gray-500" style="font-size:11px; font-weight:600;">En attente</p>
        <p class="font-black text-ink" style="font-size:22px; line-height:1;">{{ pendingCount }}</p>
      </div>
    </div>
    <div class="flex items-center gap-3 bg-white border border-gray-200 rounded-xl px-4 py-3 shadow-sm">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-emerald-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
      <div>
        <p class="text-gray-500" style="font-size:11px; font-weight:600;">À venir (confirmées)</p>
        <p class="font-black text-ink" style="font-size:22px; line-height:1;">{{ upcomingCount }}</p>
      </div>
    </div>
    <button type="button" onclick="document.getElementById('reservation-add-modal').classList.remove('hidden')"
            class="inline-flex items-center gap-2 text-white font-bold rounded-xl px-5 py-3 transition-opacity hover:opacity-90" style="background:#c8272c; font-size:13px;">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
      AJOUTER UNE RÉSERVATION
    </button>
  </div>
</div>

<!-- Filtres -->
<form method="GET" action="{{ base_path }}/admin/reservations">
  <div class="bg-white border border-gray-200 rounded-xl px-5 py-4 mb-5 shadow-sm flex flex-wrap items-center gap-3">
    <select name="status" class="border border-gray-200 rounded-lg px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-brand-500/30 focus:border-brand-500" style="font-size:13px;">
      <option value="tous"       {{ filters.status == 'tous' ? 'selected' : '' }}>Tous les statuts</option>
      <option value="en_attente" {{ filters.status == 'en_attente' ? 'selected' : '' }}>En attente</option>
      <option value="confirmee"  {{ filters.status == 'confirmee' ? 'selected' : '' }}>Confirmée</option>
      <option value="annulee"    {{ filters.status == 'annulee' ? 'selected' : '' }}>Annulée</option>
    </select>
    <input type="date" name="date" value="{{ filters.date }}" class="border border-gray-200 rounded-lg px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-brand-500/30 focus:border-brand-500" style="font-size:13px;">
    <button type="submit" class="inline-flex items-center gap-2 text-white font-bold rounded-lg px-5 py-2.5 transition-opacity hover:opacity-90" style="background:#c8272c; font-size:13px;">
      FILTRER
    </button>
    <a href="{{ base_path }}/admin/reservations" class="inline-flex items-center gap-2 font-bold rounded-lg px-4 py-2.5 border border-gray-200 text-gray-500 hover:bg-gray-50 transition-colors" style="font-size:13px;">
      Réinitialiser
    </a>
  </div>
</form>

<!-- Tableau -->
<div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
  {% if reservations is empty %}
    <div class="text-center py-16 px-6">
      <p class="text-gray-500 font-medium mb-1">Aucune réservation ne correspond à ces critères.</p>
    </div>
  {% else %}
    <div class="overflow-x-auto">
      <table class="min-w-full">
        <thead class="bg-gray-50 border-b border-gray-100">
          <tr>
            <th class="px-5 py-3 text-left font-bold text-gray-500 uppercase" style="font-size:11px; letter-spacing:0.5px;">Client</th>
            <th class="px-5 py-3 text-left font-bold text-gray-500 uppercase" style="font-size:11px; letter-spacing:0.5px;">Date &amp; heure</th>
            <th class="px-5 py-3 text-left font-bold text-gray-500 uppercase" style="font-size:11px; letter-spacing:0.5px;">Personnes</th>
            <th class="px-5 py-3 text-left font-bold text-gray-500 uppercase" style="font-size:11px; letter-spacing:0.5px;">Note</th>
            <th class="px-5 py-3 text-left font-bold text-gray-500 uppercase" style="font-size:11px; letter-spacing:0.5px;">Statut</th>
            <th class="px-5 py-3 text-right font-bold text-gray-500 uppercase" style="font-size:11px; letter-spacing:0.5px;">Actions</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-100">
          {% set statusStyles = {'en_attente': 'bg-amber-100 text-amber-700', 'confirmee': 'bg-emerald-100 text-emerald-700', 'annulee': 'bg-gray-100 text-gray-500'} %}
          {% set statusLabels = {'en_attente': 'En attente', 'confirmee': 'Confirmée', 'annulee': 'Annulée'} %}
          {% for r in reservations %}
            <tr class="hover:bg-gray-50 transition-colors">
              <td class="px-5 py-3.5 whitespace-nowrap">
                <p class="font-semibold text-ink" style="font-size:13px;">{{ r.name }}</p>
                <p class="text-gray-400" style="font-size:12px;">{{ r.phone }}</p>
              </td>
              <td class="px-5 py-3.5 whitespace-nowrap text-gray-600" style="font-size:13px;">
                {{ r.reservation_date|date('d/m/Y') }} à {{ r.reservation_time|slice(0, 5) }}
              </td>
              <td class="px-5 py-3.5 whitespace-nowrap text-gray-600" style="font-size:13px;">{{ r.party_size }}</td>
              <td class="px-5 py-3.5 text-gray-500 max-w-xs truncate" style="font-size:12.5px;">{{ r.note|default('—') }}</td>
              <td class="px-5 py-3.5 whitespace-nowrap">
                <span class="px-2.5 py-1 rounded-full font-semibold {{ statusStyles[r.status] }}" style="font-size:11.5px;">
                  {{ statusLabels[r.status] }}
                </span>
              </td>
              <td class="px-5 py-3.5 whitespace-nowrap text-right">
                <div class="inline-flex items-center gap-1.5">
                  {% if r.status != 'confirmee' %}
                    <form method="POST" action="{{ base_path }}/admin/reservations/{{ r.id }}/statut">
                      {{ csrf_field() }}
                      <input type="hidden" name="status" value="confirmee">
                      <button type="submit" class="font-semibold text-emerald-600 hover:text-emerald-700 px-2" style="font-size:12px;">Confirmer</button>
                    </form>
                  {% endif %}
                  {% if r.status != 'annulee' %}
                    <form method="POST" action="{{ base_path }}/admin/reservations/{{ r.id }}/statut">
                      {{ csrf_field() }}
                      <input type="hidden" name="status" value="annulee">
                      <button type="submit" class="font-semibold text-gray-400 hover:text-brand-500 px-2" style="font-size:12px;">Annuler</button>
                    </form>
                  {% endif %}
                  <button type="button" class="js-edit-reservation font-semibold text-gray-500 hover:text-ink px-2" style="font-size:12px;"
                          data-id="{{ r.id }}"
                          data-name="{{ r.name }}"
                          data-phone="{{ r.phone }}"
                          data-email="{{ r.email|default('') }}"
                          data-party-size="{{ r.party_size }}"
                          data-date="{{ r.reservation_date }}"
                          data-time="{{ r.reservation_time|slice(0, 5) }}"
                          data-note="{{ r.note|default('') }}"
                          data-status="{{ r.status }}">Modifier</button>
                  <form method="POST" action="{{ base_path }}/admin/reservations/{{ r.id }}/supprimer"
                        onsubmit="return confirm('Supprimer cette réservation ?');">
                    {{ csrf_field() }}
                    <button type="submit" class="font-semibold text-gray-300 hover:text-brand-500 px-2" style="font-size:12px;">Suppr.</button>
                  </form>
                </div>
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  {% endif %}
</div>

<!-- Modale : ajouter -->
<div id="reservation-add-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/40 px-4">
  <div class="bg-white rounded-2xl p-6 w-full max-w-lg shadow-xl">
    <h3 class="font-extrabold text-ink mb-4" style="font-size:16px;">Ajouter une réservation</h3>
    <form method="POST" action="{{ base_path }}/admin/reservations" class="space-y-3">
      {{ csrf_field() }}
      <div class="grid sm:grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-semibold text-gray-500 mb-1">Nom du client</label>
          <input type="text" name="name" required maxlength="120" class="form-input">
        </div>
        <div>
          <label class="block text-xs font-semibold text-gray-500 mb-1">Téléphone</label>
          <input type="tel" name="phone" required placeholder="06 12 34 56 78" class="form-input">
        </div>
      </div>
      <div>
        <label class="block text-xs font-semibold text-gray-500 mb-1">E-mail <span class="text-gray-400 font-normal">(facultatif)</span></label>
        <input type="email" name="email" class="form-input">
      </div>
      <div class="grid sm:grid-cols-3 gap-3">
        <div>
          <label class="block text-xs font-semibold text-gray-500 mb-1">Date</label>
          <input type="date" name="reservation_date" required class="form-input">
        </div>
        <div>
          <label class="block text-xs font-semibold text-gray-500 mb-1">Heure</label>
          <input type="time" name="reservation_time" required class="form-input">
        </div>
        <div>
          <label class="block text-xs font-semibold text-gray-500 mb-1">Personnes</label>
          <input type="number" name="party_size" min="1" max="30" value="2" required class="form-input">
        </div>
      </div>
      <div>
        <label class="block text-xs font-semibold text-gray-500 mb-1">Note <span class="text-gray-400 font-normal">(facultatif)</span></label>
        <input type="text" name="note" maxlength="255" class="form-input">
      </div>
      <div>
        <label class="block text-xs font-semibold text-gray-500 mb-1">Statut</label>
        <select name="status" class="form-select">
          <option value="en_attente">En attente</option>
          <option value="confirmee">Confirmée</option>
          <option value="annulee">Annulée</option>
        </select>
      </div>
      <div class="flex gap-2 justify-end pt-2">
        <button type="button" onclick="document.getElementById('reservation-add-modal').classList.add('hidden')"
                class="px-4 py-2.5 font-semibold text-gray-500 hover:text-ink transition-colors" style="font-size:13px;">Annuler</button>
        <button type="submit" class="btn-primary">Ajouter</button>
      </div>
    </form>
  </div>
</div>

<!-- Modale unique de modification, remplie en JS -->
<div id="reservation-edit-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/40 px-4">
  <div class="bg-white rounded-2xl p-6 w-full max-w-lg shadow-xl">
    <h3 id="reservation-edit-title" class="font-extrabold text-ink mb-4" style="font-size:16px;">Modifier la réservation</h3>
    <form id="reservation-edit-form" method="POST" action="{{ base_path }}/admin/reservations/0" class="space-y-3">
      {{ csrf_field() }}
      <div class="grid sm:grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-semibold text-gray-500 mb-1">Nom du client</label>
          <input type="text" name="name" required maxlength="120" class="form-input">
        </div>
        <div>
          <label class="block text-xs font-semibold text-gray-500 mb-1">Téléphone</label>
          <input type="tel" name="phone" required placeholder="06 12 34 56 78" class="form-input">
        </div>
      </div>
      <div>
        <label class="block text-xs font-semibold text-gray-500 mb-1">E-mail <span class="text-gray-400 font-normal">(facultatif)</span></label>
        <input type="email" name="email" class="form-input">
      </div>
      <div class="grid sm:grid-cols-3 gap-3">
        <div>
          <label class="block text-xs font-semibold text-gray-500 mb-1">Date</label>
          <input type="date" name="reservation_date" required class="form-input">
        </div>
        <div>
          <label class="block text-xs font-semibold text-gray-500 mb-1">Heure</label>
          <input type="time" name="reservation_time" required class="form-input">
        </div>
        <div>
          <label class="block text-xs font-semibold text-gray-500 mb-1">Personnes</label>
          <input type="number" name="party_size" min="1" max="30" required class="form-input">
        </div>
      </div>
      <div>
        <label class="block text-xs font-semibold text-gray-500 mb-1">Note <span class="text-gray-400 font-normal">(facultatif)</span></label>
        <input type="text" name="note" maxlength="255" class="form-input">
      </div>
      <div>
        <label class="block text-xs font-semibold text-gray-500 mb-1">Statut</label>
        <select name="status" class="form-select">
          <option value="en_attente">En attente</option>
          <option value="confirmee">Confirmée</option>
          <option value="annulee">Annulée</option>
        </select>
      </div>
      <div class="flex gap-2 justify-end pt-2">
        <button type="button" onclick="document.getElementById('reservation-edit-modal').classList.add('hidden')"
                class="px-4 py-2.5 font-semibold text-gray-500 hover:text-ink transition-colors" style="font-size:13px;">Annuler</button>
        <button type="submit" class="btn-primary">Enregistrer</button>
      </div>
    </form>
  </div>
</div>

<script>
(function () {
  var modal = document.getElementById('reservation-edit-modal');
  var form = document.getElementById('reservation-edit-form');
  var title = document.getElementById('reservation-edit-title');

  document.querySelectorAll('.js-edit-reservation').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var el = form.elements;
      form.action = '{{ base_path }}/admin/reservations/' + btn.dataset.id;
      el['name'].value = btn.dataset.name || '';
      el['phone'].value = btn.dataset.phone || '';
      el['email'].value = btn.dataset.email || '';
      el['party_size'].value = btn.dataset.partySize || '2';
      el['reservation_date'].value = btn.dataset.date || '';
      el['reservation_time'].value = btn.dataset.time || '';
      el['note'].value = btn.dataset.note || '';
      el['status'].value = btn.dataset.status || 'en_attente';
      title.textContent = 'Modifier la réservation de ' + (btn.dataset.name || '');
      modal.classList.remove('hidden');
    });
  });
})();
</script>
