{% set pageTitle = 'Mode maintenance' %}
{% set pageSubtitle = "Coupez l'accès public au site pour effectuer des opérations, sans jamais perdre l'accès à l'administration." %}
{% include 'partials/admin-page-header.twig' %}

<div class="max-w-3xl mx-auto space-y-6">
  {% if settings.maintenance_enabled == '1' %}
    <div class="card card-md bg-red-50 border-red-200">
      <p class="text-sm text-red-700 font-semibold flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-8.99 3h.008v.008h-.008V15z"/></svg>
        Le site public est actuellement en maintenance.
      </p>
    </div>
  {% endif %}

  <form method="POST" action="{{ base_path }}/admin/maintenance" class="space-y-6">
    {{ csrf_field() }}

    <div class="card card-md">
      <h2 class="font-bold text-ink mb-4">Activation</h2>
      <label class="flex items-center gap-3 cursor-pointer">
        <input type="checkbox" name="maintenance_enabled" value="1" {{ settings.maintenance_enabled == '1' ? 'checked' : '' }}
               class="w-5 h-5 rounded border-gray-300 text-brand-500 focus:ring-brand-500">
        <span class="text-sm font-semibold text-ink">Activer le mode maintenance</span>
      </label>
      <p class="text-xs text-gray-400 mt-2">
        Une fois activé, les visiteurs voient une page de maintenance à la place du site. L'administration
        (<code class="text-gray-600">{{ base_path }}/admin</code>) reste toujours accessible pour se connecter,
        quelle que soit l'adresse IP.
      </p>
    </div>

    <div class="card card-md">
      <h2 class="font-bold text-ink mb-2">Message affiché aux visiteurs</h2>
      <p class="text-sm text-gray-500 mb-4">Laissez vide pour afficher le message par défaut.</p>
      <textarea name="maintenance_message" rows="3" class="form-input"
                placeholder="Nous effectuons une opération de maintenance. Le site sera de nouveau disponible très prochainement.">{{ settings.maintenance_message }}</textarea>
    </div>

    <div class="card card-md">
      <h2 class="font-bold text-ink mb-2">Liste blanche des adresses IP</h2>
      <p class="text-sm text-gray-500 mb-4">
        Une adresse IP par ligne. Ces adresses continuent de voir le site public normalement même pendant la maintenance.
      </p>
      {% if currentIp %}
        <p class="text-xs text-gray-400 mb-3">
          Votre adresse IP actuelle : <code class="text-gray-600 font-mono">{{ currentIp }}</code>
        </p>
      {% endif %}
      <textarea name="maintenance_whitelist_ips" rows="5" class="form-input font-mono text-sm"
                placeholder="203.0.113.10&#10;198.51.100.24">{{ settings.maintenance_whitelist_ips }}</textarea>
    </div>

    <button type="submit" class="btn-primary w-full">
      Enregistrer
    </button>
  </form>
</div>
