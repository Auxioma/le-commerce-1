<section class="max-w-xl mx-auto px-6 py-16">
  <div class="card card-md sm:p-10 text-center">
    {% if user is null %}
      <h1 class="text-2xl font-black text-ink mb-3">Lien invalide</h1>
      <p class="text-gray-500">Ce lien de désinscription n'est pas valide. Contactez-nous si vous souhaitez ne plus recevoir nos e-mails.</p>
    {% elseif done %}
      <h1 class="text-2xl font-black text-ink mb-3">C'est fait</h1>
      <p class="text-gray-500">Vous ne recevrez plus nos e-mails d'information et de promotion. À bientôt au Commerce !</p>
    {% else %}
      <h1 class="text-2xl font-black text-ink mb-3">Ne plus recevoir nos e-mails ?</h1>
      <p class="text-gray-500 mb-6">Bonjour {{ user.first_name }}, confirmez pour ne plus recevoir nos e-mails d'information (loteries, promotions…).</p>
      <form method="POST" action="{{ base_path }}/desabonnement/{{ user.id }}/{{ token }}">
        {{ csrf_field() }}
        <button type="submit" class="btn-primary">Confirmer la désinscription</button>
      </form>
    {% endif %}
  </div>
</section>
