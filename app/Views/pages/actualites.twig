{% set heroEyebrow = 'ACTUALITÉS' %}
{% set heroText = "Toute l'actualité et les événements du Commerce à Forges-les-Eaux." %}
{% set heroSlug = 'hero_actualites' %}
{% include 'partials/page-hero.twig' %}

<section class="max-w-[1536px] mx-auto px-6 lg:px-10 py-12">
  {% if articles is empty %}
    <div class="card card-md text-center py-16">
      <p class="text-gray-500 font-medium">Aucune actualité pour le moment. Revenez bientôt !</p>
    </div>
  {% else %}
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {% for article in articles %}
        <a href="{{ base_path }}/actualites/{{ article.slug }}" class="group flex flex-col rounded-2xl overflow-hidden bg-white shadow-sm hover:shadow-md transition-shadow">
          <div class="w-full h-44 overflow-hidden">
            {% if article.image %}
              <img src="{{ base_path }}{{ article.image }}" alt="{{ article.title }}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy" decoding="async">
            {% else %}
              <div class="w-full h-full bg-brand-50 flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 text-brand-200" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4h16v16H4V4zm2 2v5l3-3 4 4 5-5V6H6zm0 9h12v2H6v-2z"/></svg>
              </div>
            {% endif %}
          </div>
          <div class="flex-1 flex flex-col p-5">
            <p class="text-xs font-semibold text-brand-500 mb-1.5">{{ article.published_at|date('d/m/Y') }}</p>
            <p class="font-bold text-ink mb-2 leading-snug group-hover:text-brand-500 transition-colors">{{ article.title }}</p>
            {% if article.excerpt %}
              <p class="text-sm text-gray-500 leading-relaxed flex-1">{{ article.excerpt }}</p>
            {% endif %}
            <span class="mt-3 text-sm font-bold text-brand-500 inline-flex items-center gap-1">
              Lire la suite
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
            </span>
          </div>
        </a>
      {% endfor %}
    </div>
  {% endif %}
</section>
